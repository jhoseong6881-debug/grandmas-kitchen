[gd_resource type="Resource" script_class="PhoneBook" format=3]

[ext_resource type="Script" path="res://scripts/data/phone_book.gd" id="1_book"]
[ext_resource type="Script" path="res://scripts/data/phone_message.gd" id="2_message"]

[sub_resource type="Resource" id="PhoneMessage_1"]
script = ExtResource("2_message")
night = 4
sender = "팀 단톡방"
messages = Array[String](["팀장: 다들 주말 잘 보내요~", "팀장: 아, {name} 씨. 복귀 날짜 정해지면 알려 줘요."])
after_text = "…답장은 내일 하기로 했다."

[sub_resource type="Resource" id="PhoneMessage_2"]
script = ExtResource("2_message")
night = 9
sender = "엄마"
messages = Array[String](["할머니 집은 어떠니?", "밥은 잘 챙겨 먹고?", "나: (부엌 사진)", "어머, 할머니 부엌 그대로네."])
after_text = "엄마가 하트를 세 개 보냈다. …엄마도 이 부엌에서 자랐지."

[sub_resource type="Resource" id="PhoneMessage_3"]
script = ExtResource("2_message")
night = 13
sender = "팀 단톡방"
messages = Array[String](["팀장: {name} 씨, 다음 주엔 볼 수 있는 거죠?"])
draft_text = "네, 월요일부터 출근하겠습"
after_text = "…휴대폰을 엎어 두었다. 내일 장사 준비부터 하자."

[resource]
script = ExtResource("1_book")
messages = Array[ExtResource("2_message")]([SubResource("PhoneMessage_1"), SubResource("PhoneMessage_2"), SubResource("PhoneMessage_3")])
