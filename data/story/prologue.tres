[gd_resource type="Resource" script_class="Story" format=3 uid="uid://cg5iq346fsjaq"]

[ext_resource type="Script" uid="uid://ksjejo13xfkx" path="res://scripts/data/story.gd" id="1_story"]
[ext_resource type="Script" uid="uid://h2aojxuhiml4" path="res://scripts/data/story_chapter.gd" id="2_chapter"]

[sub_resource type="Resource" id="Chapter_1"]
script = ExtResource("2_chapter")
title = "1장. 회색 도시"
background_color = Color(0.22, 0.24, 0.3, 1)
ambient_sound = &"subway"
lines = Array[String](["새벽 한 시, 마지막 지하철. 오늘 저녁도 편의점 삼각김밥이었다.", "다음 날 아침, 전화가 왔다. 시골 할머니가 주무시다 편안히 가셨다고.", "바쁘다는 핑계로, 다음에, 다음에… 그 '다음'은 이제 오지 않는다.", "며칠 뒤 소포가 왔다. 녹슨 열쇠, 텅 빈 레시피 공책, 그리고 편지 한 장."])

[sub_resource type="Resource" id="Chapter_2"]
script = ExtResource("2_chapter")
title = "2장. 할머니의 편지"
background_color = Color(0.3, 0.26, 0.22, 1)
is_letter = true
lines = Array[String](["우리 강아지에게.", "숲속 집이랑 작은 밥집, 너한테 남긴다.
할미 없으면 숲 이웃들이 배곯을까, 그게 걱정이여.", "레시피 노트는 한 장씩 이웃들한테 맡겨 뒀다.
따뜻한 밥 지어 주면 다들 돌려줄 거다.", "밥은 마음으로 짓는 거여. — 할미가"])

[sub_resource type="Resource" id="Chapter_3"]
script = ExtResource("2_chapter")
title = "3장. 숲속 집"
background_color = Color(0.5, 0.66, 0.46, 1)
lines = Array[String](["휴가를 내고, 숲속 할머니 집으로 왔다.", "먼지 쌓인 밥집, 식은 아궁이. 창밖 텃밭엔 할머니가 심어 둔 당근이 자라 있었다."])

[sub_resource type="Resource" id="Chapter_4"]
script = ExtResource("2_chapter")
title = "4장. 첫 손님"
background_color = Color(0.2, 0.22, 0.34, 1)
lines = Array[String](["그날 밤, 똑똑. 문틈으로 하얀 귀 두 개가 쫑긋.", "토끼: \"그 냄새… 혹시 할머니 손주예요?\"", "#이름", "토끼: \"{name}! 할머니 노트 한 장, 제가 맡고 있어요.\"", "토끼: \"그 전에… 할머니 김밥, 한 번만 다시 먹어 볼 수 있을까요?\""])

[resource]
script = ExtResource("1_story")
chapters = Array[ExtResource("2_chapter")]([SubResource("Chapter_1"), SubResource("Chapter_2"), SubResource("Chapter_3"), SubResource("Chapter_4")])
name_prompt = "토끼가 이름을 물어봐요"
