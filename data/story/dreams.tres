[gd_resource type="Resource" script_class="DreamBook" format=3]

[ext_resource type="Script" path="res://scripts/data/dream_book.gd" id="1_dream"]

[resource]
script = ExtResource("1_dream")
lines = Array[String](["…꿈속에서 할머니가 도마를 두드리며 웃고 계셨다.", "여름 평상. 할머니 무릎을 베고 누우면 부채 바람이 솔솔 불어왔다.", "할머니: \"많이 먹어라, 우리 강아지.\" 밥그릇엔 늘 밥이 산처럼 쌓여 있었다.", "비 오는 날이면 할머니는 전을 부치셨다. 지글지글 소리에 스르르 잠이 들곤 했다.", "김밥 꽁다리 하나 얻어먹으려고, 할머니 옆에 쪼그려 앉아 기다렸다.", "할머니 손은 늘 따뜻했고, 고소한 참기름 냄새가 났다.", "할머니: \"천천히 혀. 맛은 안 도망가.\"", "마당에서 다람쥐가 도토리를 굴리면, 할머니는 그걸 보며 한참을 웃으셨다.", "아궁이 앞에서 할머니가 흥얼거리던 노래. 가사는 잊었는데, 박자는 아직 손에 남아 있다.", "처음 만든 주먹밥은 다 부서졌는데, 할머니는 \"제일 맛있구먼\" 하셨다.", "별이 쏟아지던 밤, 할머니가 이불을 꼭꼭 여며 주셨다.", "꿈속의 할머니가 말씀하셨다. \"잘하고 있어, 우리 강아지.\""])
