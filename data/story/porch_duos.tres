[gd_resource type="Resource" script_class="DuoTalkBook" format=3 uid="uid://bjn1eefngpkxg"]

[ext_resource type="Script" uid="uid://drgcbfxa4sj2q" path="res://scripts/data/duo_talk_book.gd" id="1_book"]
[ext_resource type="Script" uid="uid://tvsuqap5t5w1" path="res://scripts/data/guest_duo_talk.gd" id="2_talk"]
[ext_resource type="Script" uid="uid://cekufjs6tuyj" path="res://scripts/data/duo_line.gd" id="3_line"]

[sub_resource type="Resource" id="Line_7"]
script = ExtResource("3_line")
speaker = &"bear"
expression = &"surprised"
text = "토끼야, 손 왜 그래? 붕대 감았네."

[sub_resource type="Resource" id="Line_8"]
script = ExtResource("3_line")
speaker = &"rabbit"
expression = &"surprised"
text = "아, 아무것도 아니에요! 당근 캐다가…"

[sub_resource type="Resource" id="Line_9"]
script = ExtResource("3_line")
speaker = &"bear"
text = "음~ 당근은 칼로 캐는 거였나? 이빨 자국이 아니라 칼자국인데."

[sub_resource type="Resource" id="Line_10"]
script = ExtResource("3_line")
speaker = &"rabbit"
expression = &"sad"
text = "고, 곰 아저씨! …{name}한테는 비밀이에요."

[sub_resource type="Resource" id="Line_11"]
script = ExtResource("3_line")
speaker = &"bear"
expression = &"happy"
text = "음~ 나는 아무것도 못 들었다."

[sub_resource type="Resource" id="Talk_2"]
script = ExtResource("2_talk")
id = &"duo_bear_rabbit_bandage"
open_day = 3
guest_ids = Array[StringName]([&"bear", &"rabbit"])
requires_seen_chapters = Array[StringName]([&"rabbit_spring_1"])
ends_after_chapters = Array[StringName]([&"rabbit_spring_2"])
lines = Array[ExtResource("3_line")]([SubResource("Line_7"), SubResource("Line_8"), SubResource("Line_9"), SubResource("Line_10"), SubResource("Line_11")])

[sub_resource type="Resource" id="Line_12"]
script = ExtResource("3_line")
speaker = &"squirrel"
expression = &"sad"
text = "…고슴도치 아저씨. 숲 바닥, 다 알죠?"

[sub_resource type="Resource" id="Line_13"]
script = ExtResource("3_line")
speaker = &"hedgehog"
text = "…다 안다. 왜."

[sub_resource type="Resource" id="Line_14"]
script = ExtResource("3_line")
speaker = &"squirrel"
expression = &"sad"
text = "…도토리 묻은 자리를 잃어버렸어요. 할머니 몫이요."

[sub_resource type="Resource" id="Line_15"]
script = ExtResource("3_line")
speaker = &"hedgehog"
text = "…평상에서 보이는 큰 나무. 그 아래 흙이 요즘 볼록하더라. …난 아무 말도 안 했다."

[sub_resource type="Resource" id="Line_16"]
script = ExtResource("3_line")
speaker = &"squirrel"
expression = &"surprised"
text = "…!"

[sub_resource type="Resource" id="Talk_3"]
script = ExtResource("2_talk")
id = &"duo_squirrel_hedgehog_sprout"
open_day = 3
guest_ids = Array[StringName]([&"squirrel", &"hedgehog"])
requires_seen_chapters = Array[StringName]([&"squirrel_spring_1"])
ends_after_chapters = Array[StringName]([&"squirrel_spring_2"])
lines = Array[ExtResource("3_line")]([SubResource("Line_12"), SubResource("Line_13"), SubResource("Line_14"), SubResource("Line_15"), SubResource("Line_16")])

[sub_resource type="Resource" id="Line_23"]
script = ExtResource("3_line")
speaker = &"hedgehog"
text = "…곰. 밤마다 쿵쿵거리는 거, 너지."

[sub_resource type="Resource" id="Line_24"]
script = ExtResource("3_line")
speaker = &"bear"
expression = &"surprised"
text = "쉿! …못 들은 걸로 해 줘. 평상 다리가 영 시원찮아서."

[sub_resource type="Resource" id="Line_25"]
script = ExtResource("3_line")
speaker = &"hedgehog"
text = "…삭은 나무로는 안 된다. 내 원목 하나 남았다. 내일 가져가라."

[sub_resource type="Resource" id="Line_26"]
script = ExtResource("3_line")
speaker = &"bear"
expression = &"happy"
text = "고마워, 고슴도치. 음~ 밥 한 그릇 살게."

[sub_resource type="Resource" id="Line_27"]
script = ExtResource("3_line")
speaker = &"hedgehog"
text = "…밥은 여기서 먹는 거다. 흥."

[sub_resource type="Resource" id="Talk_5"]
script = ExtResource("2_talk")
id = &"duo_hedgehog_bear_porch"
open_day = 4
guest_ids = Array[StringName]([&"hedgehog", &"bear"])
requires_seen_chapters = Array[StringName]([&"bear_spring_1"])
ends_after_chapters = Array[StringName]([&"bear_spring_2"])
lines = Array[ExtResource("3_line")]([SubResource("Line_23"), SubResource("Line_24"), SubResource("Line_25"), SubResource("Line_26"), SubResource("Line_27")])

[sub_resource type="Resource" id="Line_32"]
script = ExtResource("3_line")
speaker = &"hen"
text = "꼬꼬! 토끼야, 요즘 너희 굴에서 아침마다 탁탁탁 소리 나더라?"

[sub_resource type="Resource" id="Line_33"]
script = ExtResource("3_line")
speaker = &"rabbit"
expression = &"surprised"
text = "드, 들렸어요?"

[sub_resource type="Resource" id="Line_34"]
script = ExtResource("3_line")
speaker = &"hen"
expression = &"happy"
text = "새벽 마실 도는 내가 모르는 소리가 어디 있니! 박자가 날마다 좋아지던데? 호호."

[sub_resource type="Resource" id="Line_35"]
script = ExtResource("3_line")
speaker = &"rabbit"
expression = &"happy"
text = "…정말요? 할머니 박자 같아요?"

[sub_resource type="Resource" id="Line_36"]
script = ExtResource("3_line")
speaker = &"hen"
expression = &"happy"
text = "그럼! 탁, 탁, 탁. 꼭 네 할머니 부엌 같았어."

[sub_resource type="Resource" id="Talk_7"]
script = ExtResource("2_talk")
id = &"duo_hen_rabbit_practice"
open_day = 6
guest_ids = Array[StringName]([&"hen", &"rabbit"])
requires_seen_chapters = Array[StringName]([&"rabbit_spring_2"])
ends_after_chapters = Array[StringName]([&"rabbit_spring_3"])
lines = Array[ExtResource("3_line")]([SubResource("Line_32"), SubResource("Line_33"), SubResource("Line_34"), SubResource("Line_35"), SubResource("Line_36")])

[sub_resource type="Resource" id="Line_28"]
script = ExtResource("3_line")
speaker = &"bear"
expression = &"happy"
text = "음~ 병아리 나왔다며? 축하해, 암탉."

[sub_resource type="Resource" id="Line_29"]
script = ExtResource("3_line")
speaker = &"hen"
expression = &"happy"
text = "꼬꼬! 고마워. 근데 곰, 너는 아직 오지 마. 애들이 너 보면 놀라."

[sub_resource type="Resource" id="Line_30"]
script = ExtResource("3_line")
speaker = &"bear"
expression = &"sad"
text = "…나 이렇게 순한데."

[sub_resource type="Resource" id="Line_31"]
script = ExtResource("3_line")
speaker = &"hen"
expression = &"happy"
text = "덩치가 안 순하잖아! …대신 막내 좀 크면 평상에 데려와서 보여 줄게."

[sub_resource type="Resource" id="Talk_6"]
script = ExtResource("2_talk")
id = &"duo_bear_hen_chicks"
open_day = 5
guest_ids = Array[StringName]([&"bear", &"hen"])
requires_seen_chapters = Array[StringName]([&"hen_spring_2"])
lines = Array[ExtResource("3_line")]([SubResource("Line_28"), SubResource("Line_29"), SubResource("Line_30"), SubResource("Line_31")])

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("3_line")
speaker = &"rabbit"
text = "…"

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("3_line")
speaker = &"squirrel"
text = "…"

[sub_resource type="Resource" id="Line_3"]
script = ExtResource("3_line")
speaker = &"rabbit"
expression = &"surprised"
text = "저, 저기… 도토리 좋아해요?"

[sub_resource type="Resource" id="Line_4"]
script = ExtResource("3_line")
speaker = &"squirrel"
text = "…네. …당근은요?"

[sub_resource type="Resource" id="Line_5"]
script = ExtResource("3_line")
speaker = &"rabbit"
expression = &"happy"
text = "좋아해요! …(둘 다 고개를 푹 숙인다)"

[sub_resource type="Resource" id="Line_6"]
script = ExtResource("3_line")
speaker = &"squirrel"
expression = &"happy"
text = "…(작게) 다음에, 바꿔 먹어요."

[sub_resource type="Resource" id="Talk_1"]
script = ExtResource("2_talk")
id = &"duo_rabbit_squirrel_shy"
guest_ids = Array[StringName]([&"rabbit", &"squirrel"])
lines = Array[ExtResource("3_line")]([SubResource("Line_1"), SubResource("Line_2"), SubResource("Line_3"), SubResource("Line_4"), SubResource("Line_5"), SubResource("Line_6")])

[sub_resource type="Resource" id="Line_17"]
script = ExtResource("3_line")
speaker = &"hen"
text = "다람쥐야, 할머니 옆자리는 아직도 네 자리지?"

[sub_resource type="Resource" id="Line_18"]
script = ExtResource("3_line")
speaker = &"squirrel"
text = "…네."

[sub_resource type="Resource" id="Line_19"]
script = ExtResource("3_line")
speaker = &"hen"
expression = &"happy"
text = "나는 맞은편이었어. 할머니가 가운데서 우리 둘 챙기느라 바빴지. 호호."

[sub_resource type="Resource" id="Line_20"]
script = ExtResource("3_line")
speaker = &"squirrel"
expression = &"happy"
text = "…(작게 웃는다) …바빴어요."

[sub_resource type="Resource" id="Line_21"]
script = ExtResource("3_line")
speaker = &"squirrel"
expression = &"sad"
text = "…보고 싶어요."

[sub_resource type="Resource" id="Line_22"]
script = ExtResource("3_line")
speaker = &"hen"
expression = &"sad"
text = "그래, 나도. …그래도 오늘은 손주가 해 준 밥 먹었잖니. 꼬꼬."

[sub_resource type="Resource" id="Talk_4"]
script = ExtResource("2_talk")
id = &"duo_hen_squirrel_grandma"
open_day = 3
guest_ids = Array[StringName]([&"hen", &"squirrel"])
lines = Array[ExtResource("3_line")]([SubResource("Line_17"), SubResource("Line_18"), SubResource("Line_19"), SubResource("Line_20"), SubResource("Line_21"), SubResource("Line_22")])

[sub_resource type="Resource" id="Line_37"]
script = ExtResource("3_line")
speaker = &"hen"
text = "고슴도치! 잔치 날 꼭 와야 해. 빠지면 안 돼!"

[sub_resource type="Resource" id="Line_38"]
script = ExtResource("3_line")
speaker = &"hedgehog"
text = "…시끄러운 데는 질색이다."

[sub_resource type="Resource" id="Line_39"]
script = ExtResource("3_line")
speaker = &"hen"
text = "네 할머니가 잔치 때마다 네 자리 따로 비워 뒀던 거 알지?"

[sub_resource type="Resource" id="Line_40"]
script = ExtResource("3_line")
speaker = &"hedgehog"
expression = &"sad"
text = "…(가시가 살짝 눕는다) …버섯은 가져간다. 그것만이다."

[sub_resource type="Resource" id="Line_41"]
script = ExtResource("3_line")
speaker = &"hen"
expression = &"happy"
text = "꼬꼬! 그거면 됐어!"

[sub_resource type="Resource" id="Talk_8"]
script = ExtResource("2_talk")
id = &"duo_hen_hedgehog_feast"
open_day = 11
guest_ids = Array[StringName]([&"hen", &"hedgehog"])
lines = Array[ExtResource("3_line")]([SubResource("Line_37"), SubResource("Line_38"), SubResource("Line_39"), SubResource("Line_40"), SubResource("Line_41")])

[resource]
script = ExtResource("1_book")
talks = Array[ExtResource("2_talk")]([SubResource("Talk_2"), SubResource("Talk_3"), SubResource("Talk_5"), SubResource("Talk_7"), SubResource("Talk_6"), SubResource("Talk_1"), SubResource("Talk_4"), SubResource("Talk_8")])
