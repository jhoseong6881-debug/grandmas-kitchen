[gd_resource type="Resource" script_class="MarketSettings" format=3]

[ext_resource type="Script" path="res://scripts/data/market_settings.gd" id="1_market"]
[ext_resource type="Script" path="res://scripts/data/market_trade.gd" id="2_trade"]
[ext_resource type="Resource" path="res://data/ingredients/carrot.tres" id="3_carrot"]
[ext_resource type="Resource" path="res://data/ingredients/egg.tres" id="4_egg"]
[ext_resource type="Resource" path="res://data/ingredients/honey.tres" id="5_honey"]
[ext_resource type="Resource" path="res://data/ingredients/acorn.tres" id="6_acorn"]
[ext_resource type="Resource" path="res://data/ingredients/mushroom.tres" id="7_mushroom"]

[sub_resource type="Resource" id="Trade_1"]
script = ExtResource("2_trade")
id = &"mushroom_to_carrot"
give_ingredient = ExtResource("7_mushroom")
give_amount = 3
get_ingredient = ExtResource("3_carrot")
get_amount = 1

[sub_resource type="Resource" id="Trade_2"]
script = ExtResource("2_trade")
id = &"egg_to_carrot"
give_ingredient = ExtResource("4_egg")
give_amount = 3
get_ingredient = ExtResource("3_carrot")
get_amount = 1

[sub_resource type="Resource" id="Trade_3"]
script = ExtResource("2_trade")
id = &"acorn_to_carrot"
give_ingredient = ExtResource("6_acorn")
give_amount = 3
get_ingredient = ExtResource("3_carrot")
get_amount = 1

[sub_resource type="Resource" id="Trade_4"]
script = ExtResource("2_trade")
id = &"honey_to_carrot"
give_ingredient = ExtResource("5_honey")
give_amount = 2
get_ingredient = ExtResource("3_carrot")
get_amount = 1

[sub_resource type="Resource" id="Trade_5"]
script = ExtResource("2_trade")
id = &"mushroom_to_egg"
give_ingredient = ExtResource("7_mushroom")
give_amount = 2
get_ingredient = ExtResource("4_egg")
get_amount = 1

[sub_resource type="Resource" id="Trade_6"]
script = ExtResource("2_trade")
id = &"acorn_to_honey"
give_ingredient = ExtResource("6_acorn")
give_amount = 2
get_ingredient = ExtResource("5_honey")
get_amount = 1

[sub_resource type="Resource" id="Trade_7"]
script = ExtResource("2_trade")
id = &"egg_to_acorn"
give_ingredient = ExtResource("4_egg")
give_amount = 2
get_ingredient = ExtResource("6_acorn")
