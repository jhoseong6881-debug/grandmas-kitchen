[ext_resource type="Texture2D" path="res://assets/art/characters/rabbit/rabbit_default.png" id="50_portrait"]
[ext_resource type="Texture2D" path="res://assets/art/characters/rabbit/rabbit_happy.png" id="51_happy"]
[ext_resource type="Texture2D" path="res://assets/art/characters/rabbit/rabbit_surprised.png" id="52_surprised"]

[sub_resource type="Resource" id="EveningTalk_1"]
script = ExtResource("9_talk")
line = "비 오는 날이면 할머니가 당근전을 부쳐 주셨어요. 고소한 냄새가 우리 집까지 났어요."
replies = Array[String](["그 냄새, 저도 기억날 것 같아요", "비 오는 날 또 놀러 와요"])
reactions = Array[String](["정말요? …그럼 우리, 같은 냄새를 기억하는 거네요.", "네! 비 오는 날만 기다릴게요… 아, 아니 맑은 날도요."])

[sub_resource type="Resource" id="EveningTalk_2"]
script = ExtResource("9_talk")
line = "안녕하세요… 여기 밥집 다시 연 거 맞죠?"
replies = Array[String](["네, 이제 매일 열어요", "할머니만큼 잘할 수 있을지 모르겠어요"])
reactions = Array[String](["다행이다… 매일 올게요. 정말로요.", "저, 저는… 벌써 할머니만큼 맛있다고 생각해요."])

[sub_resource type="Resource" id="EveningTalk_3"]
script = ExtResource("9_talk")
line = "할머니 김밥, 정말 그리웠어요."
replies = Array[String](["내일도 김밥 싸 드릴게요", "할머니 김밥은 뭐가 특별했어요?"])
reactions = Array[String](["와… 내일은 당근 제일 예쁜 걸로 가져올게요.", "음… 당근을 아주 가늘게, 정성껏 썰었어요. 지금 {name}처럼요."])

[sub_resource type="Resource" id="TierTalk_1"]
script = ExtResource("9_talk")
line = "사실… 저 처음 할머니 만났을 때, 밭에서 당근 훔쳐 먹다 걸렸어요."
replies = Array[String](["할머니가 화내셨어요?", "그래서 당근을 좋아하는군요"])
reactions = Array[String](["아뇨. 다음 날 제 몫으로 한 줄을 따로 심어 주셨어요. 그게… 지금 그 밭이에요.", "헤헤… 맞아요. 그날부터 당근은 할머니 맛이에요."])

[sub_resource type="Resource" id="Reward_1"]
script = ExtResource("30_reward")
talk = SubResource("TierTalk_1")
gift_line = "이거… 제일 예쁜 당근이에요."
gift_ingredient = ExtResource("31_gift")
gift_amount = 3

[sub_resource type="Resource" id="TierTalk_2"]
script = ExtResource("9_talk")
line = "할머니 가시던 날… 저 문 앞에서 밤새 기다렸어요. 불이 다시 켜질까 봐."
replies = Array[String](["이제 매일 켜져 있을 거예요", "많이 무서웠겠어요"])
reactions = Array[String](["…네. 그래서 {name} 오던 날, 저 울 뻔했어요.", "조금요. 근데 지금은 괜찮아요. 여기 따뜻하니까."])

[sub_resource type="Resource" id="Reward_2"]
script = ExtResource("30_reward")
talk = SubResource("TierTalk_2")
gift_line = "밭을 한 칸 더 일궜어요. 굴 파는 건 자신 있거든요!"
extra_plot_place_id = &"carrot_field"

[sub_resource type="Resource" id="TierTalk_3"]
script = ExtResource("9_talk")
line = "{name}… 한 달 지나면, 도시로 돌아가요?"
replies = Array[String](["아직 모르겠어요", "여기 있을까 생각 중이에요"])
reactions = Array[String](["…그렇구나. 그래도 오늘은 여기 있으니까 괜찮아요.", "정말요?! …아, 아니에요. 그냥 좋아서요."])

[sub_resource type="Resource" id="Reward_3"]
script = ExtResource("30_reward")
talk = SubResource("TierTalk_3")
gift_line = "이 손수건… 할머니가 저한테 맡기신 거예요. 이제 {name} 거예요."
keepsake = ExtResource("32_keepsake")

[sub_resource type="Resource" id="StoryTalk_1"]
script = ExtResource("9_talk")
line = "(손을 등 뒤로 쏙 감춘다) 아, 아무것도 아니에요!"
expression = &"surprised"
replies = Array[String](["손 다쳤어요?", "뭐 숨겼어요?"])
reactions = Array[String](["그, 그냥… 당근 캐다가요. 정말이에요.", "아, 아무것도요! …진짜로요."])
reaction_expressions = Array[StringName]([&"sad", &"surprised"])

[sub_resource type="Resource" id="StoryTalk_2"]
script = ExtResource("9_talk")
line = "…{name}, 칼 쓸 때 손 안 다치는 법 있어요? 그, 그냥 궁금해서요."
replies = Array[String](["손가락을 고양이 손처럼 말아요", "천천히 하면 돼요"])
reactions = Array[String](["고양이 손… 고양이 손. (붕대 감은 손을 꼭 말아 본다)", "천천히… 네, 천천히요."])
reaction_expressions = Array[StringName]([&"", &""])

[sub_resource type="Resource" id="StoryTalk_3"]
script = ExtResource("9_talk")
line = "…들켰다. 붕대, 사실 칼 때문이었어요."
expression = &"sad"
replies = Array[String](["뭘 썰고 있었어요?", "괜찮아요, 화 안 내요"])
reactions = Array[String](["김밥 연습이요. 할머니한테 배우다가… 다 못 배웠거든요.", "…다행이다. 사실 김밥 연습했어요. 할머니한테 배우다 만 거요."])
reaction_expressions = Array[StringName]([&"sad", &"happy"])

[sub_resource type="Resource" id="StoryTalk_4"]
script = ExtResource("9_talk")
line = "할머니가 \"다음에 마저 알려 주마\" 하셨는데… 그다음이 안 왔어요."
expression = &"sad"

[sub_resource type="Resource" id="StoryTalk_5"]
script = ExtResource("9_talk")
line = "그래서 혼자 해 보는 중이에요. {name}한테 꼭 한 번 싸 주고 싶어서요."
expression = &"happy"

[sub_resource type="Resource" id="StoryTalk_6"]
script = ExtResource("9_talk")
line = "(은박지 뭉치를 꼭 쥐고) 이, 이거… {name} 먹으라고요."
expression = &"surprised"
replies = Array[String](["와, 김밥이네요!", "직접 싼 거예요?"])
reactions = Array[String](["모양은… 엉망이에요. 당근이 굵었다 가늘었다 해요.", "네… 당근이 굵었다 가늘었다 엉망이지만요."])
reaction_expressions = Array[StringName]([&"sad", &"sad"])

[sub_resource type="Resource" id="StoryTalk_7"]
script = ExtResource("9_talk")
line = "…어때요?"
replies = Array[String](["모양이 제각각이니 씹는 맛이 있네요", "할머니 김밥 맛이 나요"])
reactions = Array[String](["…! 할머니도 똑같이 말씀하셨어요. 제가 처음 썬 당근 보고요.", "(귀가 빨개진다) …그럼 또 싸 올게요. 매일은 말고, 가끔요."])
reaction_expressions = Array[StringName]([&"surprised", &"happy"])

[sub_resource type="Resource" id="StoryChapter_1"]
script = ExtResource("40_chapter")
id = &"rabbit_spring_1"
open_day = 3
basket_note = "어제 일은 잊어 주세요. 손은 진짜 괜찮아요!"
talks = Array[ExtResource("9_talk")]([SubResource("StoryTalk_1"), SubResource("StoryTalk_2")])

[sub_resource type="Resource" id="StoryChapter_2"]
script = ExtResource("40_chapter")
id = &"rabbit_spring_2"
open_day = 6
basket_note = "비밀 지켜 줘서 고마워요. 오늘도 연습할 거예요. 탁, 탁, 탁."
talks = Array[ExtResource("9_talk")]([SubResource("StoryTalk_3"), SubResource("StoryTalk_4"), SubResource("StoryTalk_5")])

[sub_resource type="Resource" id="StoryChapter_3"]
script = ExtResource("40_chapter")
id = &"rabbit_spring_3"
open_day = 10
basket_note = "김밥 다 먹었어요? …다 먹었으면 좋겠다."
talks = Array[ExtResource("9_talk")]([SubResource("StoryTalk_6"), SubResource("StoryTalk_7")])

[resource]
script = ExtResource("1_guest")
id = &"rabbit"
icon_placeholder_color = Color(0.96, 0.9, 0.9, 1)
display_name = "토끼"
portrait = ExtResource("50_portrait")
expression_portraits = Dictionary[StringName, Texture2D]({
&"happy": ExtResource("51_happy"),
&"surprised": ExtResource("52_surprised")
})
personality = "수줍음이 많지만 당근 이야기만 나오면 말이 많아진다."
favorite_recipes = Array[ExtResource("2_recipe")]([ExtResource("4_kimbop"), ExtResource("6_jeon"), ExtResource("7_jorim")])
disliked_recipes = Array[ExtResource("2_recipe")]([ExtResource("8_disliked")])
payment_ingredients = Array[ExtResource("3_ingredient")]([ExtResource("5_carrot")])
order_line = "저, 저기… {recipe} 하나 주실 수 있나요?"
rain_order_line = "비, 비 맞고 왔더니 으슬으슬해요… 따뜻한 {recipe} 주실 수 있나요?"
curious_order_line = "저, 저기… 오늘은 {recipe}도 궁금해서요… 주실 수 있나요?"
request_missed_line = "부탁한 대로는 아니지만… 그래도 맛있어요!"
grandma_taste_line = "…할머니 맛이에요. 눈물 날 것 같아요."
fallback_order_line = "저, 저기… 오늘은 {recipe}… 그거라도 괜찮아요."
no_dish_line = "저… 오늘은 제가 먹을 수 있는 게 없네요. 다음에 또 올게요!"
first_order_line = "와, 진짜 밥집 문이 열렸네요! 할머니 계실 때도 제가 첫 손님이었어요. …{recipe} 하나 주실 수 있나요?"
taste_hint_line = "아, 저는 양념 없이 담백한 게 좋아요."
porch_greeting_line = "저… 저녁에도 와도 돼요? 할머니 계실 땐 이 평상에서 같이 별을 봤거든요."
basket_notes = Array[String](["어제 밥 정말 맛있었어요. {ingredient}, 제일 예쁜 걸로 골랐어요.", "오늘도 문 열죠? 점심때 꼭 갈게요!", "밭 지나가다가 살짝 놓고 가요. 들키면 부끄러우니까요.", "비 오는 날엔 당근전… 아, 아니에요. 그냥 맛있게 드세요."])
promise_ask_line = "저… 내일 점심에 {recipe} 먹으러 와도 돼요? 그게… 자꾸 생각나서요."
promise_accept_line = "정말요? 내일 제일 먼저 올게요!"
promise_decline_line = "아, 아니에요! 괜찮아요. 다음에요."
promise_order_line = "약속한 {recipe}… 먹으러 왔어요. 헤헤."
promise_kept_line = "약속 지켜 주셨네요… 이 맛, 오래 기억할게요."
promise_missed_line = "아… 오늘은 {recipe} 없구나. 괜찮아요, 그럼…"
thanks_line = "정말 맛있었어요… 또 와도 되죠?"
perfect_line = "와… 칼질 솜씨가 할머니랑 똑같아요! 이거, 당근 더 드릴게요."
evening_talks = Array[ExtResource("9_talk")]([SubResource("EveningTalk_1"), SubResource("EveningTalk_2"), SubResource("EveningTalk_3")])
story_chapters = Array[ExtResource("40_chapter")]([SubResource("StoryChapter_1"), SubResource("StoryChapter_2"), SubResource("StoryChapter_3")])
note_recipes = Array[ExtResource("2_recipe")]([ExtResource("6_jeon")])
feast_line = "저… 이렇게 다 같이 모이니까, 할머니 계실 때 같아요."
story_feast_line = "(삐뚤빼뚤한 김밥 한 접시를 상에 올린다) 저… 이것도 올려도 되죠? 이번엔 당근을 조금 더 고르게 썰었어요. 조금요."
note_line = "그때 할머니가 적어 주신 레시피예요. 「{recipe}」… 이제 여기 있어야 할 것 같아서요."
favorite_garnish = ExtResource("20_garnish")
taste_miss_line = "음… 저는 당근 본맛이 좋은데. 아무것도 안 올려도 돼요."
taste_match_line = "이거예요! 당근 맛이 그대로 나요."
regular_rewards = Array[ExtResource("30_reward")]([SubResource("Reward_1"), SubResource("Reward_2"), SubResource("Reward_3")])
