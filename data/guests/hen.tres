[gd_resource type="Resource" script_class="AnimalGuest" format=3]

[ext_resource type="Script" path="res://scripts/data/animal_guest.gd" id="1_guest"]
[ext_resource type="Script" path="res://scripts/data/recipe.gd" id="2_recipe"]
[ext_resource type="Script" path="res://scripts/data/ingredient.gd" id="3_ingredient"]
[ext_resource type="Resource" path="res://data/recipes/carrot_egg_stir_fry.tres" id="4_stir_fry"]
[ext_resource type="Resource" path="res://data/recipes/carrot_kimbop.tres" id="5_kimbop"]
[ext_resource type="Resource" path="res://data/ingredients/egg.tres" id="6_egg"]
[ext_resource type="Resource" path="res://data/recipes/honey_egg_roll.tres" id="7_egg_roll"]
[ext_resource type="Resource" path="res://data/recipes/acorn_honey_gangjeong.tres" id="8_disliked"]
[ext_resource type="Script" path="res://scripts/data/evening_talk.gd" id="9_talk"]
[ext_resource type="Resource" path="res://data/garnishes/sesame_oil.tres" id="20_garnish"]
[ext_resource type="Script" path="res://scripts/data/regular_reward.gd" id="30_reward"]
[ext_resource type="Resource" path="res://data/ingredients/egg.tres" id="31_gift"]
[ext_resource type="Resource" path="res://data/keepsakes/grandma_egg_basket.tres" id="32_keepsake"]

[sub_resource type="Resource" id="EveningTalk_1"]
script = ExtResource("9_talk")
line = "오늘 아침엔 해가 일찍 떴지 뭐야."
replies = Array[String](["암탉님 덕분에 일찍 일어났어요.", "그래서 텃밭 당근이 반짝였구나."])
reactions = Array[String](["꼬꼬! 그게 내 일이지. 내일도 깨워 줄게!", "어머, 텃밭까지 챙기는구나. 할머니 닮았네!"])

[sub_resource type="Resource" id="EveningTalk_2"]
script = ExtResource("9_talk")
line = "네 할머니는 계란말이를 참 잘하셨어."
replies = Array[String](["비결이 뭐였을까요?", "저도 언젠가 꼭 배워 볼게요."])
reactions = Array[String](["불은 약하게, 마음은 넉넉하게. 그게 다였어.", "그럼 내가 계란은 넉넉히 대 줄게!"])

[sub_resource type="Resource" id="EveningTalk_3"]
script = ExtResource("9_talk")
line = "요즘 숲이 좀 시끌벅적해졌어. 다 네 밥집 덕이야."
replies = Array[String](["다들 와 줘서 고마워요.", "시끄러워서 싫으세요?"])
reactions = Array[String](["고맙긴! 우리가 고맙지. 꼬꼬!", "싫긴! 나야 수다 떨 이웃이 늘어서 신나지!"])

[sub_resource type="Resource" id="TierTalk_1"]
script = ExtResource("9_talk")
line = "나는 원래 장터 닭이었어. 팔려 갈 뻔했는데, 네 할머니가 나를 사서 그냥 풀어 줬지."
replies = Array[String](["할머니답다", "그래서 숲에 살게 됐구나"])
reactions = Array[String](["그렇지? 대신 매일 계란 하나씩 갖다 주기로 약속했어. 지금까지 지키는 중!", "응! 그날부터 아침마다 제일 먼저 우는 게 내 일이야. 꼬꼬!"])

[sub_resource type="Resource" id="Reward_1"]
script = ExtResource("30_reward")
talk = SubResource("TierTalk_1")
gift_line = "갓 낳은 계란이야! 따끈할 때 써!"
gift_ingredient = ExtResource("31_gift")
gift_amount = 3

[sub_resource type="Resource" id="TierTalk_2"]
script = ExtResource("9_talk")
line = "네 할머니 젊었을 땐 말이야, 이 숲에서 제일 목소리 큰 사람이었어."
replies = Array[String](["정말? 상상이 안 돼", "나는 할머니 닮았어?"])
reactions = Array[String](["호호! 밥 먹으라고 부르는 소리가 산 너머까지 들렸다니까.", "음… 웃을 때 눈이 똑같아. 꼬꼬."])

[sub_resource type="Resource" id="Reward_2"]
script = ExtResource("30_reward")
talk = SubResource("TierTalk_2")
gift_line = "오늘은 특별히 넉넉하게! 꼬꼬!"
gift_ingredient = ExtResource("31_gift")
gift_amount = 5

[sub_resource type="Resource" id="TierTalk_3"]
script = ExtResource("9_talk")
line = "아침에 네 부엌에서 밥 냄새가 나면, 나 그거 맡고 일어나. 해보다 먼저."
replies = Array[String](["내가 깨워 주는 거네", "이제 서로 깨워 주자"])
reactions = Array[String](["그래! 이제 우리 둘이 이 숲의 아침 당번이야!", "좋아, 약속! 꼬꼬!"])

[sub_resource type="Resource" id="Reward_3"]
script = ExtResource("30_reward")
talk = SubResource("TierTalk_3")
gift_line = "네 할머니가 쓰던 계란 바구니야. 이제 네가 써."
keepsake = ExtResource("32_keepsake")

[resource]
script = ExtResource("1_guest")
id = &"hen"
display_name = "암탉"
personality = "새벽마다 마을을 깨우는 부지런한 수다쟁이. 할머니와 아침마다 수다를 떨던 사이."
favorite_recipes = Array[ExtResource("2_recipe")]([ExtResource("4_stir_fry"), ExtResource("5_kimbop"), ExtResource("7_egg_roll")])
disliked_recipes = Array[ExtResource("2_recipe")]([ExtResource("8_disliked")])
payment_ingredients = Array[ExtResource("3_ingredient")]([ExtResource("6_egg"), ExtResource("6_egg")])
order_line = "어머, 밥집 다시 열었구나! {recipe} 하나 줄래?"
fallback_order_line = "어머, 오늘은 그게 없니? 그럼 {recipe}, 그거 줘!"
thanks_line = "꼬꼬, 잘 먹었다! 계란은 내일도 갖다줄게."
perfect_line = "어머머, 이 솜씨 좀 봐! 네 할머니가 보셨으면 좋아하셨겠다. 계란 하나 더!"
evening_talks = Array[ExtResource("9_talk")]([SubResource("EveningTalk_1"), SubResource("EveningTalk_2"), SubResource("EveningTalk_3")])
note_recipes = Array[ExtResource("2_recipe")]([ExtResource("4_stir_fry"), ExtResource("7_egg_roll")])
feast_line = "꼬꼬! 잔치엔 계란이 빠질 수 없지! 오늘은 내가 한턱낸다!"
note_line = "참, 이거 네 할머니가 나한테 적어 준 레시피야. 「{recipe}」. 이제 네가 가지고 있어야지."
favorite_garnish = ExtResource("20_garnish")
taste_miss_line = "맛있다만… 고소한 참기름 향이 살짝 났으면 딱인데!"
taste_match_line = "꼬꼬! 이 고소한 냄새! 내 입맛을 아는구나!"
regular_rewards = Array[ExtResource("30_reward")]([SubResource("Reward_1"), SubResource("Reward_2"), SubResource("Reward_3")])
