[ext_resource type="Resource" path="res://data/keepsakes/grandma_egg_basket.tres" id="32_keepsake"]
[ext_resource type="Script" path="res://scripts/data/guest_story_chapter.gd" id="40_chapter"]

[sub_resource type="Resource" id="EveningTalk_1"]
script = ExtResource("9_talk")
line = "오늘 아침엔 해가 일찍 떴지 뭐야."
replies = Array[String](["암탉님 덕분에 일찍 일어났어요.", "그래서 텃밭 당근이 반짝였군요."])
reactions = Array[String](["꼬꼬! 그게 내 일이지. 내일도 깨워 줄게!", "어머, 텃밭까지 챙기는구나. 할머니 닮았네!"])

[sub_resource type="Resource" id="EveningTalk_2"]
script = ExtResource("9_talk")
line = "네 할머니는 계란말이를 참 잘하셨어."
replies = Array[String](["비결이 뭐였을까요?", "저도 언젠가 꼭 배워 볼게요."])
reactions = Array[String](["불은 약하게, 마음은 넉넉하게. 그게 다였어.", "그럼 내가 계란은 넉넉히 대 줄게!"])

[sub_resource type="Resource" id="EveningTalk_3"]
script = ExtResource("9_talk")
line = "요즘 숲이 좀 시끌벅적해졌어. 다 네 밥집 덕이야."
replies = Array[String](["다들 와 줘서 고마워요.", "시끄러워서 싫으세요?"])
reactions = Array[String](["고맙긴! 우리가 고맙지. 꼬꼬!", "싫긴! 나야 수다 떨 이웃이 늘어서 신나지!"])

[sub_resource type="Resource" id="TierTalk_1"]
script = ExtResource("9_talk")
line = "나는 원래 장터 닭이었어. 팔려 갈 뻔했는데, 네 할머니가 나를 사서 그냥 풀어 줬지."
replies = Array[String](["할머니다워요", "그래서 숲에 살게 됐군요"])
reactions = Array[String](["그렇지? 대신 매일 계란 하나씩 갖다 주기로 약속했어. 지금까지 지키는 중!", "응! 그날부터 아침마다 제일 먼저 우는 게 내 일이야. 꼬꼬!"])

[sub_resource type="Resource" id="Reward_1"]
script = ExtResource("30_reward")
talk = SubResource("TierTalk_1")
gift_line = "갓 낳은 계란이야! 따끈할 때 써!"
gift_ingredient = ExtResource("31_gift")
gift_amount = 3

[sub_resource type="Resource" id="TierTalk_2"]
script = ExtResource("9_talk")
line = "네 할머니 젊었을 땐 말이야, 이 숲에서 제일 목소리 큰 사람이었어."
replies = Array[String](["정말요? 상상이 안 돼요", "저는 할머니 닮았어요?"])
reactions = Array[String](["호호! 밥 먹으라고 부르는 소리가 산 너머까지 들렸다니까.", "음… 웃을 때 눈이 똑같아. 꼬꼬."])

[sub_resource type="Resource" id="Reward_2"]
script = ExtResource("30_reward")
talk = SubResource("TierTalk_2")
gift_line = "오늘은 특별히 넉넉하게! 꼬꼬!"
gift_ingredient = ExtResource("31_gift")
gift_amount = 5

[sub_resource type="Resource" id="TierTalk_3"]
script = ExtResource("9_talk")
line = "아침에 네 부엌에서 밥 냄새가 나면, 나 그거 맡고 일어나. 해보다 먼저."
replies = Array[String](["제가 깨워 드리는 거네요", "이제 서로 깨워 줘요"])
reactions = Array[String](["그래! 이제 우리 둘이 이 숲의 아침 당번이야!", "좋아, 약속! 꼬꼬!"])

[sub_resource type="Resource" id="Reward_3"]
script = ExtResource("30_reward")
talk = SubResource("TierTalk_3")
gift_line = "네 할머니가 쓰던 계란 바구니야. 이제 네가 써."
keepsake = ExtResource("32_keepsake")

[sub_resource type="Resource" id="StoryTalk_1"]
script = ExtResource("9_talk")
line = "꼬꼬… 오늘 아침에 나 늦게 울었지? 미안해."
expression = &"sad"
replies = Array[String](["무슨 일 있어요?", "푹 주무셨나 봐요"])
reactions = Array[String](["사실… 요즘 알을 품고 있거든. 꼼짝 않고 앉아 있으려니 아침이 오는 줄도 몰랐지 뭐야.", "푹은커녕! 알 품느라 밤새 꼼짝도 못 했어. 꼬꼬."])
reaction_expressions = Array[StringName]([&"happy", &"surprised"])

[sub_resource type="Resource" id="StoryTalk_2"]
script = ExtResource("9_talk")
line = "네 할머니가 그러셨어. 알 품을 땐 아침 당번은 쉬어도 된다고. 해는 내가 안 깨워도 뜬다고. 호호."
expression = &"happy"

[sub_resource type="Resource" id="StoryChapter_1"]
script = ExtResource("40_chapter")
id = &"hen_spring_1"
open_day = 2
basket_note = "알 품느라 오늘도 늦잠. 미안! 대신 넉넉히 두고 간다. 꼬꼬."
talks = Array[ExtResource("9_talk")]([SubResource("StoryTalk_1"), SubResource("StoryTalk_2")])

[sub_resource type="Resource" id="StoryTalk_3"]
script = ExtResource("9_talk")
line = "꼬꼬꼬! 들었니? 비 오던 그 밤에, 알이 깨졌어! 병아리가 나왔다고!"
expression = &"surprised"
replies = Array[String](["축하해요!", "몇 마리예요?"])
reactions = Array[String](["고마워! 근데 이게 말이야…", "다섯! 그런데 말이야…"])
reaction_expressions = Array[StringName]([&"happy", &"happy"])

[sub_resource type="Resource" id="StoryTalk_4"]
script = ExtResource("9_talk")
line = "막내 하나가 너무 작아. 삐약 소리도 제일 작고, 모이도 제일 늦게 먹어."
expression = &"sad"
replies = Array[String](["막내는 원래 천천히 커요", "제가 뭐 도와드릴까요?"])
reactions = Array[String](["…그렇겠지? 네 할머니도 똑같이 말씀하셨을 거야.", "그럼 내일 쌀 한 줌만 줄래? 제일 고운 걸로. 꼬꼬."])
reaction_expressions = Array[StringName]([&"happy", &"happy"])

[sub_resource type="Resource" id="StoryChapter_2"]
script = ExtResource("40_chapter")
id = &"hen_spring_2"
open_day = 5
basket_note = "막내가 오늘 모이를 한 톨 먹었어! 한 톨! 꼬꼬꼬!"
talks = Array[ExtResource("9_talk")]([SubResource("StoryTalk_3"), SubResource("StoryTalk_4")])

[sub_resource type="Resource" id="StoryTalk_5"]
script = ExtResource("9_talk")
line = "(날개 밑에서 병아리들이 고개를 쏙쏙 내민다) 꼬꼬! 오늘은 애들 데리고 왔어. 저 끝에 막내 봐, 제일 시끄럽지?"
expression = &"happy"
replies = Array[String](["많이 컸네요!", "목소리가 엄마 닮았네요"])
reactions = Array[String](["네 밥집 앞에 떨어진 밥알 주워 먹고 이렇게 컸어. 이젠 형들보다 먼저 먹는다니까!", "호호! 그러게, 벌써 새벽마다 같이 울어."])
reaction_expressions = Array[StringName]([&"happy", &"happy"])

[sub_resource type="Resource" id="StoryTalk_6"]
script = ExtResource("9_talk")
line = "그래서 말인데… 막내 이름을 네 할머니 이름으로 지어도 될까?"
replies = Array[String](["물론이죠. 할머니도 좋아하실 거예요", "대신 할머니처럼 목소리 크게 키워 주세요"])
reactions = Array[String](["…고마워. 이제 이 숲에서 할머니 이름이 매일 아침 불리겠네. 꼬꼬.", "걱정 마! 밥 먹으라는 소리가 산 너머까지 들리게 키울게!"])
reaction_expressions = Array[StringName]([&"happy", &"happy"])

[sub_resource type="Resource" id="StoryChapter_3"]
script = ExtResource("40_chapter")
id = &"hen_spring_3"
open_day = 9
basket_note = "막내가 오늘 아침 처음으로 울었어. 할머니 이름 부르니까 대답하더라. 꼬꼬."
talks = Array[ExtResource("9_talk")]([SubResource("StoryTalk_5"), SubResource("StoryTalk_6")])

[resource]
script = ExtResource("1_guest")
id = &"hen"
icon_placeholder_color = Color(0.9, 0.4, 0.32, 1)
display_name = "암탉"
personality = "새벽마다 마을을 깨우는 부지런한 수다쟁이. 할머니와 아침마다 수다를 떨던 사이."
favorite_recipes = Array[ExtResource("2_recipe")]([ExtResource("4_stir_fry"), ExtResource("5_kimbop"), ExtResource("7_egg_roll")])
disliked_recipes = Array[ExtResource("2_recipe")]([ExtResource("8_disliked")])
payment_ingredients = Array[ExtResource("3_ingredient")]([ExtResource("31_gift"), ExtResource("31_gift")])
order_line = "꼬꼬, 오늘도 왔다! {recipe} 하나 줄래?"
rain_order_line = "꼬꼬, 비 오는 날엔 역시 따끈한 게 최고지! {recipe} 하나 줄래?"
curious_order_line = "어머, 저건 처음 보는 요리네? {recipe} 하나 줘 볼래?"
speaks_casually = true
request_missed_line = "어머, 부탁이랑은 좀 다르네? 그래도 맛있다!"
grandma_taste_line = "꼬꼬! 이거 네 할머니 손맛이잖니!"
fallback_order_line = "어머, 오늘은 그게 없니? 그럼 {recipe}, 그거 줘!"
no_dish_line = "어머, 오늘은 내 입에 맞는 게 하나도 없네! 다음엔 기대할게, 꼬꼬!"
first_order_line = "어머머, 밥집에 불이 켜졌길래 와 봤지! 네가 그 손주구나? 네 할머니네 아침 단골이 바로 나란다. {recipe} 하나 줄래?"
taste_hint_line = "참기름 고소한 냄새 나면 더 좋고!"
porch_greeting_line = "꼬꼬! 저녁 평상이 다시 열렸네! 네 할머니랑 여기서 하루 얘기 나누는 게 낙이었단다."
basket_notes = Array[String](["{ingredient} 두고 간다! 따끈할 때 써. 꼬꼬!", "오늘 아침도 내가 깨웠지? 해보다 먼저! 꼬꼬.", "어제 저녁 수다 즐거웠어. 오늘도 밥 냄새 기다린다!", "네 할머니도 이 바구니를 아침마다 열어 보셨지. 호호."])
promise_ask_line = "꼬꼬! 내일 점심 메뉴로 {recipe}, 해 줄 수 있니?"
promise_accept_line = "약속! 아침에 내가 깨워 줄게. 꼬꼬!"
promise_decline_line = "호호, 바쁘면 다음에 해 줘!"
promise_order_line = "꼬꼬! 약속한 {recipe} 먹으러 왔지!"
promise_kept_line = "역시 약속을 지키는구나! 네 할머니랑 똑같아. 꼬꼬!"
promise_missed_line = "어머, 오늘 메뉴판에 {recipe} 없네? 그럼…"
thanks_line = "꼬꼬, 잘 먹었다! 계란은 내일도 갖다줄게."
perfect_line = "어머머, 이 솜씨 좀 봐! 네 할머니가 보셨으면 좋아하셨겠다. 계란 하나 더!"
evening_talks = Array[ExtResource("9_talk")]([SubResource("EveningTalk_1"), SubResource("EveningTalk_2"), SubResource("EveningTalk_3")])
story_chapters = Array[ExtResource("40_chapter")]([SubResource("StoryChapter_1"), SubResource("StoryChapter_2"), SubResource("StoryChapter_3")])
note_recipes = Array[ExtResource("2_recipe")]([ExtResource("4_stir_fry"), ExtResource("7_egg_roll")])
feast_line = "꼬꼬! 잔치엔 계란이 빠질 수 없지! 오늘은 내가 한턱낸다!"
story_feast_line = "꼬꼬! 우리 애들도 데려왔어! 막내야, 인사해야지. …봐, 할머니 이름 부르니까 제일 크게 대답하잖아!"
note_line = "참, 이거 네 할머니가 나한테 적어 준 레시피야. 「{recipe}」. 이제 네가 가지고 있어야지."
favorite_garnish = ExtResource("20_garnish")
taste_miss_line = "맛있다만… 고소한 참기름 향이 살짝 났으면 딱인데!"
taste_match_line = "꼬꼬! 이 고소한 냄새! 내 입맛을 아는구나!"
regular_rewards = Array[ExtResource("30_reward")]([SubResource("Reward_1"), SubResource("Reward_2"), SubResource("Reward_3")])
