[ext_resource type="Resource" path="res://data/ingredients/honey.tres" id="31_gift"]
[ext_resource type="Resource" path="res://data/keepsakes/grandma_honey_jar.tres" id="32_keepsake"]
[ext_resource type="Script" path="res://scripts/data/guest_story_chapter.gd" id="40_chapter"]

[sub_resource type="Resource" id="EveningTalk_1"]
script = ExtResource("10_talk")
line = "겨울잠 자는 동안 할머니 꿈을 꿨어."
replies = Array[String](["무슨 꿈이었어요?", "할머니가 뭐라고 하셨어요?"])
reactions = Array[String](["밥 냄새 나는 꿈… 깨 보니 진짜 밥 냄새가 나더라. 여기서.", "\"배고프면 언제든 와라.\" 그래서 왔지."])

[sub_resource type="Resource" id="EveningTalk_2"]
script = ExtResource("10_talk")
line = "할머니는 내가 오면 늘 꿀 넣은 반찬을 해 주셨지."
replies = Array[String](["꿀은 곰이 가져온 거였어요?", "저도 꿀 반찬 연구해 볼게요"])
reactions = Array[String](["응. 꿀 한 병에 반찬 한 접시. 그게 우리 약속이었어.", "음~ 기대된다. 꿀은 넉넉히 있어."])

[sub_resource type="Resource" id="EveningTalk_3"]
script = ExtResource("10_talk")
line = "봄바람 냄새가 좋다. 낮잠 자기 딱이야."
replies = Array[String](["여기서 한숨 자고 가요", "밥 먹고 바로 자면 안 돼요!"])
reactions = Array[String](["음… 평상이 딱 좋은 크기네… 쿨…", "에이, 곰은 원래 그래도 돼. 음~"])

[sub_resource type="Resource" id="TierTalk_1"]
script = ExtResource("10_talk")
line = "나 어릴 때 꿀 따다가 벌한테 엄청 쏘였거든. 그때 할머니가 된장을 발라 줬어."
replies = Array[String](["된장을요?", "아팠겠어요"])
reactions = Array[String](["응! 냄새는 고약했는데 신기하게 나았어. 할머니는 뭐든 알았어.", "엄청. 근데 할머니가 꿀 반찬 해 줘서 다 잊었지. 음~"])

[sub_resource type="Resource" id="Reward_1"]
script = ExtResource("30_reward")
talk = SubResource("TierTalk_1")
gift_line = "올봄 첫 꿀이야. 음~"
gift_ingredient = ExtResource("31_gift")
gift_amount = 3

[sub_resource type="Resource" id="TierTalk_2"]
script = ExtResource("10_talk")
line = "겨울잠 들기 전날엔 늘 여기 들렀어. 할머니가 도시락을 싸 주셨거든. 깨면 먹으라고."
replies = Array[String](["올겨울엔 제가 싸 드릴게요", "도시락엔 뭐가 들었어요?"])
reactions = Array[String](["…정말? 음… 그럼 봄이 더 기다려지겠다.", "꿀 주먹밥. 깨면 딱딱해져 있었는데, 그게 제일 맛있었어."])

[sub_resource type="Resource" id="Reward_2"]
script = ExtResource("30_reward")
talk = SubResource("TierTalk_2")
gift_line = "벌들한테 부탁해서 넉넉히 받아 왔어."
gift_ingredient = ExtResource("31_gift")
gift_amount = 5

[sub_resource type="Resource" id="TierTalk_3"]
script = ExtResource("10_talk")
line = "{name}, 피곤하면 나처럼 좀 자. 도시 사람들은 너무 안 자."
replies = Array[String](["여기선 잘 자요", "가끔 같이 낮잠 자요"])
reactions = Array[String](["그래 보여. 처음 왔을 때보다 얼굴이 폈어.", "음~ 좋지. 평상은 둘이 누워도 넉넉해."])

[sub_resource type="Resource" id="Reward_3"]
script = ExtResource("30_reward")
talk = SubResource("TierTalk_3")
gift_line = "할머니 꿀단지야. 꿀은 계속 채워 줄게."
keepsake = ExtResource("32_keepsake")

[sub_resource type="Resource" id="StoryTalk_1"]
script = ExtResource("10_talk")
line = "음~ 잘 잤어? 어젯밤에 혹시… 무슨 소리 못 들었어?"
replies = Array[String](["평상 쪽에서 쿵쿵 소리 났어요", "아뇨, 푹 잤는데요"])
reactions = Array[String](["쿠, 쿵쿵? 음… 바람 소리겠지. 봄바람이 원래 좀 쿵쿵거려.", "다행이다! …아, 아니. 푹 잤다니 다행이라고."])
reaction_expressions = Array[StringName]([&"surprised", &"happy"])

[sub_resource type="Resource" id="StoryTalk_2"]
script = ExtResource("10_talk")
line = "(담 너머로 평상 다리를 힐끗 본다) 음~ 오늘은 평상에 너무 세게 앉지 마. 그냥… 그래야 할 것 같아서."
expression = &"surprised"

[sub_resource type="Resource" id="StoryChapter_1"]
script = ExtResource("40_chapter")
id = &"bear_spring_1"
open_day = 4
basket_note = "어젯밤엔 진짜 아무 소리 안 났어. 바람이야, 바람."
talks = Array[ExtResource("10_talk")]([SubResource("StoryTalk_1"), SubResource("StoryTalk_2")])

[sub_resource type="Resource" id="StoryTalk_3"]
script = ExtResource("10_talk")
line = "…들켰구나. 그 쿵쿵 소리, 나였어."
expression = &"sad"
replies = Array[String](["밤에 뭐 했어요?", "평상 고치셨군요"])
reactions = Array[String](["평상 다리가 삭아서 흔들리더라. 할머니가 늘 거기 앉으셨는데, 부러지면 안 되잖아.", "응… 다리 하나가 삭았더라. 밤에 몰래 고치려고 했지."])
reaction_expressions = Array[StringName]([&"sad", &"sad"])

[sub_resource type="Resource" id="StoryTalk_4"]
script = ExtResource("10_talk")
line = "할머니 계실 땐 평상 고치는 게 내 일이었어. 밥 얻어먹는 값으로. 음~ 이제 다시 내 일이야."
expression = &"happy"
replies = Array[String](["고마워요, 곰", "다음엔 같이 고쳐요"])
reactions = Array[String](["고맙긴. 밥값이지. 꿀 반찬 한 접시면 충분해.", "좋아! 둘이 하면 쿵쿵 소리도 반만 나겠다."])
reaction_expressions = Array[StringName]([&"happy", &"happy"])

[sub_resource type="Resource" id="StoryChapter_2"]
script = ExtResource("40_chapter")
id = &"bear_spring_2"
open_day = 8
basket_note = "평상 다리 하나 다 고쳤어. 오늘 밤엔 세게 앉아도 돼. 음~"
talks = Array[ExtResource("10_talk")]([SubResource("StoryTalk_3"), SubResource("StoryTalk_4")])

[sub_resource type="Resource" id="StoryTalk_5"]
script = ExtResource("10_talk")
line = "{name}, 이리 와 봐. 평상 밑에 고개 넣어 봐. 음~ 보여?"
expression = &"happy"
replies = Array[String](["금이 잔뜩 그어져 있네요", "이게 뭐예요?"])
reactions = Array[String](["키 잰 자국이야. 할머니가 손님들 키를 여기다 쟀어. 이건 토끼, 이건 다람쥐…", "할머니가 새긴 거야. 손님들 키 자국. 이건 토끼, 이건 다람쥐…"])
reaction_expressions = Array[StringName]([&"", &""])

[sub_resource type="Resource" id="StoryTalk_6"]
script = ExtResource("10_talk")
line = "맨 끝에 제일 작은 거 보여? 옆에 이름도 있어. …{name}, 너야. 여기 놀러 왔던 어린 너."
expression = &"happy"
replies = Array[String](["…저도 여기 있었네요", "할머니가 이걸 남겨 두셨군요"])
reactions = Array[String](["응. 할머니가 그 금 볼 때마다 웃으셨어. 음~ 이제 여기 금 하나 더 그어야지. 지금 네 키로.", "응. 평상 고치다가 처음 봤어. 그래서 더 꼼꼼히 고쳤지. 음~"])
reaction_expressions = Array[StringName]([&"happy", &"sad"])

[sub_resource type="Resource" id="StoryChapter_3"]
script = ExtResource("40_chapter")
id = &"bear_spring_3"
open_day = 12
basket_note = "그 금, 오늘 밤에 그어 줄게. 까치발 들면 안 돼."
talks = Array[ExtResource("10_talk")]([SubResource("StoryTalk_5"), SubResource("StoryTalk_6")])

[sub_resource type="Resource" id="HomeTalk_1"]
script = ExtResource("10_talk")
line = "여기가 내 동굴. 겨울 내내 여기서 잤어. 아직 좀 졸려."
replies = Array[String](["푹 주무셨어요?", "봄인데 일어나셔야죠"])
reactions = Array[String](["응. 할머니 꿈 꾸면서. 깨니까 배고프더라. 음~", "알아, 알아. 그래서 밥집 가잖아. 그게 내 아침 운동이야."])

[sub_resource type="Resource" id="HomeTalk_2"]
script = ExtResource("10_talk")
line = "동굴 앞 벌집 보여? 벌들이랑은 오래된 사이야. 꿀은 조금씩만 나눠 받아."
replies = Array[String](["벌이랑 친해요?", "그래서 꿀이 맛있구나"])
reactions = Array[String](["어릴 땐 엄청 쏘였지. 이제는 서로 봐주는 사이. 음~", "응. 욕심내면 맛이 없어. 할머니가 그랬어."])

[sub_resource type="Resource" id="HomeTalk_3"]
script = ExtResource("10_talk")
line = "저 선반 위 도시락 통, 할머니가 겨울잠 전에 싸 주시던 거야."
replies = Array[String](["아직 간직하고 계셨어요?", "반질반질하게 닦아 두셨네요"])
reactions = Array[String](["버릴 수가 없더라. 꿀 냄새가 아직 나.", "응. 할머니가 보면 웃으실 거야. 음~"])

[resource]
script = ExtResource("1_guest")
id = &"bear"
icon_placeholder_color = Color(0.48, 0.32, 0.2, 1)
display_name = "곰"
personality = "겨울잠에서 막 깬 느긋하고 다정한 곰. 늘 배가 고프다. 할머니 밥집의 오랜 단골이었다."
favorite_recipes = Array[ExtResource("2_recipe")]([ExtResource("4_carrot_kimbop"), ExtResource("5_honey_carrot_jorim"), ExtResource("6_acorn_honey_gangjeong"), ExtResource("7_honey_egg_roll")])
disliked_recipes = Array[ExtResource("2_recipe")]([ExtResource("9_disliked")])
payment_ingredients = Array[ExtResource("3_ingredient")]([ExtResource("31_gift"), ExtResource("31_gift")])
order_line = "음… 배고프다… {recipe} 하나 줄 수 있니?"
rain_order_line = "음… 빗소리 들으니까 더 배고프다… 따끈한 {recipe} 하나 줄 수 있니?"
curious_order_line = "음… 저 냄새는 뭐지… {recipe}도 먹어 볼 수 있니?"
speaks_casually = true
request_missed_line = "음… 부탁한 거랑은 다르지만… 맛있으니까 괜찮아."
grandma_taste_line = "음… 이 맛… 할머니 밥집 맛이다…"
fallback_order_line = "음… 아무거나 좋아… {recipe}, 그거 줄래?"
no_dish_line = "음… 오늘은 내가 먹을 게 없네. 괜찮아, 다음에 또 올게. 음~"
first_order_line = "음… 이 냄새, 할머니 밥집이다! 겨울잠 자는 동안 문 닫은 줄 알고 얼마나 섭섭했는데. 네가 손주구나, 반갑다. {recipe} 하나 줄 수 있니?"
taste_hint_line = "음… 달달하면 더 좋겠다."
porch_greeting_line = "음~ 배부르니 평상에 눕고 싶다. 할머니는 저녁마다 이 담 너머로 나랑 차를 나눠 마셨지."
basket_notes = Array[String](["음~ {ingredient} 두고 간다. 벌들이 안부 전하래.", "어제 평상에서 깜빡 졸았어. 미안. 음~", "배고프다. 점심 기다린다. 음~", "할머니 밥 냄새랑 네 밥 냄새, 이제 잘 구분이 안 돼. 좋은 뜻이야."])
promise_ask_line = "음~ 내일 점심에 {recipe} 먹고 싶다. 해 줄 수 있어?"
promise_accept_line = "좋아! 내일은 배를 비워 두고 올게. 음~"
promise_decline_line = "음~ 그래, 다음에 먹지 뭐."
promise_order_line = "약속한 {recipe} 먹으러 왔어. 배 비워 왔지. 음~"
promise_kept_line = "음~ 약속한 맛이다. 배도 마음도 든든해."
promise_missed_line = "음? 오늘은 {recipe} 없어? …아쉽다. 그럼…"
thanks_line = "음~ 든든하다. 꿀 두고 갈게."
perfect_line = "우와… 이 맛이야! 할머니 생각난다. 꿀 듬뿍 줄게."
evening_talks = Array[ExtResource("10_talk")]([SubResource("EveningTalk_1"), SubResource("EveningTalk_2"), SubResource("EveningTalk_3")])
story_chapters = Array[ExtResource("40_chapter")]([SubResource("StoryChapter_1"), SubResource("StoryChapter_2"), SubResource("StoryChapter_3")])
note_recipes = Array[ExtResource("2_recipe")]([ExtResource("5_honey_carrot_jorim"), ExtResource("6_acorn_honey_gangjeong")])
feast_line = "음~ 겨울잠 깨길 정말 잘했다. 이 밥집 덕분에."
story_feast_line = "음~ 평상이 하나도 안 삐걱거리지? 오늘 다 같이 앉아도 끄떡없어. 이따 키 재는 거 잊지 마, {name}."
note_line = "할머니가 겨울잠 자기 전에 주신 쪽지야. 「{recipe}」… 이제 네 거야."
favorite_garnish = ExtResource("20_garnish")
taste_miss_line = "음~ 맛있다. 근데 조금만 더 달콤했으면…"
taste_match_line = "음~! 꿀이다! 이렇게 달콤할 수가!"
regular_rewards = Array[ExtResource("30_reward")]([SubResource("Reward_1"), SubResource("Reward_2"), SubResource("Reward_3")])
home_name = "곰네 동굴"
home_color = Color(0.55, 0.47, 0.4, 1)
home_greeting_lines = Array[String](["어, {name}! 동굴까지 와 줬네. 앉아, 바위가 따뜻해.", "왔어? 방금 낮잠에서 깼어. …아니, 아침잠인가. 음~"])
home_talks = Array[ExtResource("10_talk")]([SubResource("HomeTalk_1"), SubResource("HomeTalk_2"), SubResource("HomeTalk_3")])
favorite_gift = ExtResource("31_gift")
favorite_gift_line = "꿀이다! 음~ 벌들이 준 꿀이 돌고 돌아 또 나한테 왔네. 좋다."
gift_thanks_line = "{ingredient}? 음~ 고마워. 배고플 때 하나씩 먹을게."
