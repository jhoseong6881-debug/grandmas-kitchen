[sub_resource type="Resource" id="EveningTalk_1"]
script = ExtResource("10_talk")
line = "겨울잠 자는 동안 할머니 꿈을 꿨어."
replies = Array[String](["무슨 꿈이었어?", "할머니가 뭐라고 하셨어?"])
reactions = Array[String](["밥 냄새 나는 꿈… 깨 보니 진짜 밥 냄새가 나더라. 여기서.", "\"배고프면 언제든 와라.\" 그래서 왔지."])

[sub_resource type="Resource" id="EveningTalk_2"]
script = ExtResource("10_talk")
line = "할머니는 내가 오면 늘 꿀 넣은 반찬을 해 주셨지."
replies = Array[String](["꿀은 곰이 가져온 거였어?", "나도 꿀 반찬 연구해 볼게."])
reactions = Array[String](["응. 꿀 한 병에 반찬 한 접시. 그게 우리 약속이었어.", "음~ 기대된다. 꿀은 넉넉히 있어."])

[sub_resource type="Resource" id="EveningTalk_3"]
script = ExtResource("10_talk")
line = "봄바람 냄새가 좋다. 낮잠 자기 딱이야."
replies = Array[String](["여기서 한숨 자고 가.", "밥 먹고 바로 자면 안 돼요!"])
reactions = Array[String](["음… 평상이 딱 좋은 크기네… 쿨…", "에이, 곰은 원래 그래도 돼. 음~"])

[sub_resource type="Resource" id="TierTalk_1"]
script = ExtResource("10_talk")
line = "나 어릴 때 꿀 따다가 벌한테 엄청 쏘였거든. 그때 할머니가 된장을 발라 줬어."
replies = Array[String](["된장을?", "아팠겠다"])
reactions = Array[String](["응! 냄새는 고약했는데 신기하게 나았어. 할머니는 뭐든 알았어.", "엄청. 근데 할머니가 꿀 반찬 해 줘서 다 잊었지. 음~"])

[sub_resource type="Resource" id="Reward_1"]
script = ExtResource("30_reward")
talk = SubResource("TierTalk_1")
gift_line = "올봄 첫 꿀이야. 음~"
gift_ingredient = ExtResource("31_gift")
gift_amount = 3

[sub_resource type="Resource" id="TierTalk_2"]
script = ExtResource("10_talk")
line = "겨울잠 들기 전날엔 늘 여기 들렀어. 할머니가 도시락을 싸 주셨거든. 깨면 먹으라고."
replies = Array[String](["올겨울엔 내가 싸 줄게", "도시락엔 뭐가 들었어?"])
reactions = Array[String](["…정말? 음… 그럼 봄이 더 기다려지겠다.", "꿀 주먹밥. 깨면 딱딱해져 있었는데, 그게 제일 맛있었어."])

[sub_resource type="Resource" id="Reward_2"]
script = ExtResource("30_reward")
talk = SubResource("TierTalk_2")
gift_line = "벌들한테 부탁해서 넉넉히 받아 왔어."
gift_ingredient = ExtResource("31_gift")
gift_amount = 5

[sub_resource type="Resource" id="TierTalk_3"]
script = ExtResource("10_talk")
line = "{name}, 피곤하면 나처럼 좀 자. 도시 사람들은 너무 안 자."
replies = Array[String](["여기선 잘 자", "가끔 같이 낮잠 자자"])
reactions = Array[String](["그래 보여. 처음 왔을 때보다 얼굴이 폈어.", "음~ 좋지. 평상은 둘이 누워도 넉넉해."])

[sub_resource type="Resource" id="Reward_3"]
script = ExtResource("30_reward")
talk = SubResource("TierTalk_3")
gift_line = "할머니 꿀단지야. 꿀은 계속 채워 줄게."
keepsake = ExtResource("32_keepsake")

[resource]
script = ExtResource("1_guest")
id = &"bear"
display_name = "곰"
personality = "겨울잠에서 막 깬 느긋하고 다정한 곰. 늘 배가 고프다. 할머니 밥집의 오랜 단골이었다."
favorite_recipes = Array[ExtResource("2_recipe")]([ExtResource("4_carrot_kimbop"), ExtResource("5_honey_carrot_jorim"), ExtResource("6_acorn_honey_gangjeong"), ExtResource("7_honey_egg_roll")])
disliked_recipes = Array[ExtResource("2_recipe")]([ExtResource("9_disliked")])
payment_ingredients = Array[ExtResource("3_ingredient")]([ExtResource("31_gift"), ExtResource("31_gift")])
order_line = "음… 배고프다… {recipe} 하나 줄 수 있니?"
rain_order_line = "음… 빗소리 들으니까 더 배고프다… 따끈한 {recipe} 하나 줄 수 있니?"
fallback_order_line = "음… 아무거나 좋아… {recipe}, 그거 줄래?"
first_order_line = "음… 이 냄새, 할머니 밥집이다! 겨울잠 자는 동안 문 닫은 줄 알고 얼마나 섭섭했는데. 네가 손주구나, 반갑다. {recipe} 하나 줄 수 있니?"
taste_hint_line = "음… 달달하면 더 좋겠다."
porch_greeting_line = "음~ 배부르니 평상에 눕고 싶다. 할머니는 저녁마다 여기서 나랑 차를 마셨지."
thanks_line = "음~ 든든하다. 꿀 두고 갈게."
perfect_line = "우와… 이 맛이야! 할머니 생각난다. 꿀 듬뿍 줄게."
evening_talks = Array[ExtResource("10_talk")]([SubResource("EveningTalk_1"), SubResource("EveningTalk_2"), SubResource("EveningTalk_3")])
note_recipes = Array[ExtResource("2_recipe")]([ExtResource("5_honey_carrot_jorim"), ExtResource("6_acorn_honey_gangjeong")])
feast_line = "음~ 겨울잠 깨길 정말 잘했다. 이 밥집 덕분에."
note_line = "할머니가 겨울잠 자기 전에 주신 쪽지야. 「{recipe}」… 이제 네 거야."
favorite_garnish = ExtResource("20_garnish")
taste_miss_line = "음~ 맛있다. 근데 조금만 더 달콤했으면…"
taste_match_line = "음~! 꿀이다! 이렇게 달콤할 수가!"
regular_rewards = Array[ExtResource("30_reward")]([SubResource("Reward_1"), SubResource("Reward_2"), SubResource("Reward_3")])
