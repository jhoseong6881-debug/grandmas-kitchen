[gd_resource type="Resource" script_class="AnimalGuest" format=3]

[ext_resource type="Script" path="res://scripts/data/animal_guest.gd" id="1_guest"]
[ext_resource type="Script" path="res://scripts/data/recipe.gd" id="2_recipe"]
[ext_resource type="Script" path="res://scripts/data/ingredient.gd" id="3_ingredient"]
[ext_resource type="Resource" path="res://data/recipes/carrot_kimbop.tres" id="4_carrot_kimbop"]
[ext_resource type="Resource" path="res://data/recipes/honey_carrot_jorim.tres" id="5_honey_carrot_jorim"]
[ext_resource type="Resource" path="res://data/recipes/acorn_honey_gangjeong.tres" id="6_acorn_honey_gangjeong"]
[ext_resource type="Resource" path="res://data/recipes/honey_egg_roll.tres" id="7_honey_egg_roll"]
[ext_resource type="Resource" path="res://data/ingredients/honey.tres" id="8_honey"]
[ext_resource type="Resource" path="res://data/recipes/acorn_jelly_muchim.tres" id="9_disliked"]

[resource]
script = ExtResource("1_guest")
id = &"bear"
display_name = "곰"
personality = "겨울잠에서 막 깬 느긋하고 다정한 곰. 늘 배가 고프다. 할머니 밥집의 오랜 단골이었다."
favorite_recipes = Array[ExtResource("2_recipe")]([ExtResource("4_carrot_kimbop"), ExtResource("5_honey_carrot_jorim"), ExtResource("6_acorn_honey_gangjeong"), ExtResource("7_honey_egg_roll")])
disliked_recipes = Array[ExtResource("2_recipe")]([ExtResource("9_disliked")])
payment_ingredients = Array[ExtResource("3_ingredient")]([ExtResource("8_honey"), ExtResource("8_honey")])
order_line = "음… 배고프다… {recipe} 하나 줄 수 있니?"
fallback_order_line = "음… 아무거나 좋아… {recipe}, 그거 줄래?"
thanks_line = "음~ 든든하다. 꿀 두고 갈게."
perfect_line = "우와… 이 맛이야! 할머니 생각난다. 꿀 듬뿍 줄게."
dialogue_lines = Array[String](["겨울잠 자는 동안 할머니 꿈을 꿨어.", "할머니는 내가 오면 늘 꿀 넣은 반찬을 해 주셨지.", "봄바람 냄새가 좋다. 낮잠 자기 딱이야."])
note_recipes = Array[ExtResource("2_recipe")]([ExtResource("5_honey_carrot_jorim"), ExtResource("6_acorn_honey_gangjeong")])
feast_line = "음~ 겨울잠 깨길 정말 잘했다. 이 밥집 덕분에."
note_line = "할머니가 겨울잠 자기 전에 주신 쪽지야. 「{recipe}」… 이제 네 거야."
