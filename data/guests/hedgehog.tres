[ext_resource type="Resource" path="res://data/keepsakes/mushroom_basket.tres" id="32_keepsake"]
[ext_resource type="Script" path="res://scripts/data/guest_story_chapter.gd" id="40_chapter"]

[sub_resource type="Resource" id="EveningTalk_1"]
script = ExtResource("10_talk")
line = "…네가 할머니 손주냐. …눈매가 닮았군."
replies = Array[String](["할머니를 잘 아셨군요", "잘 부탁드려요"])
reactions = Array[String](["…버섯 철마다 왔다. 비 온 다음 날 새벽에 딴 걸 들고.", "…흥. 밥이 맛있으면 버섯은 계속 가져온다."])

[sub_resource type="Resource" id="EveningTalk_2"]
script = ExtResource("10_talk")
line = "할머니는 내 가시를 무서워하지 않았어."
replies = Array[String](["저도 안 무서워요.", "가시가 따갑진 않아요?"])
reactions = Array[String](["…그런가. …그래.", "…다정한 사람한테는 안 세운다. 지금처럼."])

[sub_resource type="Resource" id="EveningTalk_3"]
script = ExtResource("10_talk")
line = "숲속 길은 내가 다 알아. 길 잃으면 불러."
replies = Array[String](["든든해요. 고마워요.", "길 잃으면 꼭 부를게요."])
reactions = Array[String](["…흥. 밥값이다.", "…부르기 전에 찾아갈 거다."])

[sub_resource type="Resource" id="TierTalk_1"]
script = ExtResource("10_talk")
line = "…가시 때문에 다들 날 피했다. 네 할머니만 빼고."
replies = Array[String](["할머니는 어떻게 하셨어요?", "저도 안 피해요"])
reactions = Array[String](["…장갑 끼고 악수하더군. …웃기는 사람이었다.", "…알고 있다. …그러니까 오는 거다."])

[sub_resource type="Resource" id="Reward_1"]
script = ExtResource("30_reward")
talk = SubResource("TierTalk_1")
gift_line = "…비 온 다음 날 딴 거다."
gift_ingredient = ExtResource("31_gift")
gift_amount = 3

[sub_resource type="Resource" id="TierTalk_2"]
script = ExtResource("10_talk")
line = "…네 할머니 마지막 해에, 버섯 따러 같이 못 갔다. 다리가 아프다고."
replies = Array[String](["대신 제가 같이 갈게요", "그때 많이 서운하셨겠어요"])
reactions = Array[String](["…비 온 다음 날. 새벽에. …늦지 마라.", "…조금. …그래서 버섯을 몰래 문 앞에 두고 갔다. …매일."])

[sub_resource type="Resource" id="Reward_2"]
script = ExtResource("30_reward")
talk = SubResource("TierTalk_2")
gift_line = "…원목 하나 더 구해 왔다. …무겁더군."
extra_plot_place_id = &"mushroom_logs"

[sub_resource type="Resource" id="TierTalk_3"]
script = ExtResource("10_talk")
line = "…숲속 길, 이제 네가 다 알 때까지 알려 준다. 길 잃지 마라."
replies = Array[String](["든든해요, 고마워요", "길 잃으시면 저도 불러 주세요"])
reactions = Array[String](["…흥. 식구니까.", "…! …그래. …부르마."])

[sub_resource type="Resource" id="Reward_3"]
script = ExtResource("30_reward")
talk = SubResource("TierTalk_3")
gift_line = "…네 할머니랑 쓰던 바구니다. …이제 네 거다."
keepsake = ExtResource("32_keepsake")

[sub_resource type="Resource" id="StoryTalk_1"]
script = ExtResource("10_talk")
line = "…네 할머니가 끝내 못 가 본 자리가 하나 있다."
replies = Array[String](["어떤 자리인데요?", "왜 못 가셨어요?"])
reactions = Array[String](["…버섯이 동그랗게 나는 자리다. 숲 깊은 데. 내가 언젠가 보여 준다고 했었지.", "…다리가 아팠다. 내가 너무 늦게 말했다."])
reaction_expressions = Array[StringName]([&"", &"sad"])

[sub_resource type="Resource" id="StoryTalk_2"]
script = ExtResource("10_talk")
line = "…할머니는 그랬다. 동그랗게 난 버섯은 누가 오래 기다린 자리라고. …흥, 그런 걸 믿는 사람이었다."

[sub_resource type="Resource" id="StoryChapter_1"]
script = ExtResource("40_chapter")
id = &"hedgehog_spring_1"
open_day = 4
basket_note = "…그 자리, 언젠가 보여 주마. 언젠가."
talks = Array[ExtResource("10_talk")]([SubResource("StoryTalk_1"), SubResource("StoryTalk_2")])

[sub_resource type="Resource" id="StoryTalk_3"]
script = ExtResource("10_talk")
line = "…오늘 새벽, 거기 다녀왔다. 비 그친 다음이라 딱 좋았지."
replies = Array[String](["버섯 있었어요?", "혼자 가셨어요?"])
reactions = Array[String](["…있었다. 이끼 위에 동그랗게. 할머니 말대로.", "…혼자 갔다. …원래 둘이 가기로 한 데였는데."])
reaction_expressions = Array[StringName]([&"surprised", &"sad"])

[sub_resource type="Resource" id="StoryTalk_4"]
script = ExtResource("10_talk")
line = "(가시 사이에서 작은 버섯 하나를 꺼낸다) …이건 먹는 거 아니다. 그냥… 보라고 가져왔다."
replies = Array[String](["예뻐요. 할머니도 보셨으면", "고마워요, 잘 둘게요"])
reactions = Array[String](["…그러니까 너한테 가져온 거다. …눈매가 닮았으니까.", "…흥. 말리면 오래 간다. 부엌 창가에 둬라."])
reaction_expressions = Array[StringName]([&"sad", &""])

[sub_resource type="Resource" id="StoryChapter_2"]
script = ExtResource("40_chapter")
id = &"hedgehog_spring_2"
open_day = 8
basket_note = "…버섯, 창가에 뒀냐. 햇볕이 너무 세면 안 된다."
talks = Array[ExtResource("10_talk")]([SubResource("StoryTalk_3"), SubResource("StoryTalk_4")])

[sub_resource type="Resource" id="StoryTalk_5"]
script = ExtResource("10_talk")
line = "…이거. (낡은 가죽 장갑 한 켤레를 내민다) 네 할머니가 나랑 악수할 때 끼던 거다."
replies = Array[String](["할머니 장갑이군요", "이걸 왜 저한테요?"])
reactions = Array[String](["…가시에 긁혀서 구멍투성이다. 그래도 끝까지 이걸 꼈지.", "…이제 필요 없어서다."])
reaction_expressions = Array[StringName]([&"", &""])

[sub_resource type="Resource" id="StoryTalk_6"]
script = ExtResource("10_talk")
line = "…(가시를 착 눕힌다) 손 내밀어 봐라. …장갑 없이."
replies = Array[String](["(손을 내민다)", "따끔해도 괜찮아요"])
reactions = Array[String](["…봐라. 안 따갑지. …다정한 사람한테는 안 세운다고 했잖냐.", "…안 따끔하게 할 거다. …식구한테는."])
reaction_expressions = Array[StringName]([&"happy", &"happy"])

[sub_resource type="Resource" id="StoryChapter_3"]
script = ExtResource("40_chapter")
id = &"hedgehog_spring_3"
open_day = 11
basket_note = "…장갑은 네가 가져라. 버섯 딸 때 껴라. 손 다친다."
talks = Array[ExtResource("10_talk")]([SubResource("StoryTalk_5"), SubResource("StoryTalk_6")])

[resource]
script = ExtResource("1_guest")
id = &"hedgehog"
icon_placeholder_color = Color(0.6, 0.55, 0.5, 1)
display_name = "고슴도치"
personality = "가시가 뾰족해 무뚝뚝해 보이지만 꼼꼼하고 다정하다. 숲 바닥 버섯 자리는 모르는 데가 없다."
favorite_recipes = Array[ExtResource("2_recipe")]([ExtResource("4_carrot_kimbop"), ExtResource("5_forest_mushroom_stir_fry"), ExtResource("6_mushroom_egg_jeon"), ExtResource("7_acorn_jelly_mushroom_bap")])
disliked_recipes = Array[ExtResource("2_recipe")]([ExtResource("9_disliked")])
payment_ingredients = Array[ExtResource("3_ingredient")]([ExtResource("31_gift"), ExtResource("31_gift")])
order_line = "{recipe}. 따뜻하게 부탁해."
rain_order_line = "비 오는 날엔 할머니 밥집 부엌이 제일 따뜻했지. …{recipe}. 따뜻하게 부탁해."
curious_order_line = "…{recipe}. 처음 보는군. 하나 줘 봐."
speaks_casually = true
request_missed_line = "…부탁한 거랑은 다르군. 뭐, 맛은 있다."
grandma_taste_line = "…이건 그 사람 손맛이군."
fallback_order_line = "없나. …그럼 {recipe}. 그걸로 하지."
no_dish_line = "…먹을 게 없군. …다음에 오지."
first_order_line = "…할머니 밥집 단골이었다. 손주가 문을 열었다길래 와 봤지. …{recipe}. 따뜻하게 부탁해."
taste_hint_line = "…맵싸하게 해 주면 좋겠군."
porch_greeting_line = "…평상이군. 네 할머니는 여기서 내 가시 사이 낙엽을 떼어 주곤 했다."
basket_notes = Array[String](["…{ingredient}. 비 온 다음 날 딴 거다.", "…흥. 밥값이다.", "…숲길이 젖었다. 미끄러우니 조심해라.", "…어제 밥, 나쁘지 않았다."])
promise_ask_line = "…내일 점심. {recipe}. …되겠냐."
promise_accept_line = "…흥. 늦지 마라."
promise_decline_line = "…그래. 다음에."
promise_order_line = "…약속한 {recipe}. 왔다."
promise_kept_line = "…약속을 지키는군. …네 할머니도 그랬다."
promise_missed_line = "…{recipe}, 없군. …됐다. 그럼…"
thanks_line = "…잘 먹었어. 버섯, 두고 간다."
perfect_line = "흠… 완벽하군. 제일 좋은 버섯으로 더 주지."
evening_talks = Array[ExtResource("10_talk")]([SubResource("EveningTalk_1"), SubResource("EveningTalk_2"), SubResource("EveningTalk_3")])
story_chapters = Array[ExtResource("40_chapter")]([SubResource("StoryChapter_1"), SubResource("StoryChapter_2"), SubResource("StoryChapter_3")])
note_recipes = Array[ExtResource("2_recipe")]([ExtResource("5_forest_mushroom_stir_fry"), ExtResource("6_mushroom_egg_jeon")])
feast_line = "…흠. 이런 날도 나쁘지 않군. 다음 계절에도 들르지."
story_feast_line = "…(장갑 없이 손을 내민다) 잔치 날엔 악수하는 거다. …네 할머니가 정한 규칙이다."
note_line = "할머니가 내게 맡겨 둔 거다. 「{recipe}」. 돌려줄 때가 됐군."
favorite_garnish = ExtResource("20_garnish")
taste_miss_line = "…나쁘지 않군. …좀 더 화끈해도 된다."
taste_match_line = "…흥. 맵싸하군. …마음에 든다."
regular_rewards = Array[ExtResource("30_reward")]([SubResource("Reward_1"), SubResource("Reward_2"), SubResource("Reward_3")])
