[gd_resource type="Resource" script_class="AnimalGuest" format=3]

[ext_resource type="Script" path="res://scripts/data/animal_guest.gd" id="1_guest"]
[ext_resource type="Script" path="res://scripts/data/recipe.gd" id="2_recipe"]
[ext_resource type="Script" path="res://scripts/data/ingredient.gd" id="3_ingredient"]
[ext_resource type="Resource" path="res://data/recipes/acorn_jelly_muchim.tres" id="4_acorn_jelly"]
[ext_resource type="Resource" path="res://data/recipes/carrot_kimbop.tres" id="5_kimbop"]
[ext_resource type="Resource" path="res://data/ingredients/acorn.tres" id="6_acorn"]
[ext_resource type="Resource" path="res://data/recipes/acorn_jelly_mushroom_bap.tres" id="7_mukbap"]
[ext_resource type="Resource" path="res://data/recipes/acorn_honey_gangjeong.tres" id="8_gangjeong"]
[ext_resource type="Resource" path="res://data/recipes/carrot_egg_stir_fry.tres" id="9_disliked"]
[ext_resource type="Script" path="res://scripts/data/evening_talk.gd" id="10_talk"]
[ext_resource type="Resource" path="res://data/garnishes/sesame_salt.tres" id="20_garnish"]
[ext_resource type="Script" path="res://scripts/data/regular_reward.gd" id="30_reward"]
[ext_resource type="Resource" path="res://data/ingredients/acorn.tres" id="31_gift"]
[ext_resource type="Resource" path="res://data/keepsakes/acorn_spinning_top.tres" id="32_keepsake"]
[ext_resource type="Script" path="res://scripts/data/guest_story_chapter.gd" id="40_chapter"]

[sub_resource type="Resource" id="EveningTalk_1"]
script = ExtResource("10_talk")
line = "…할머니가 도토리묵 해 주셨었어요."
replies = Array[String](["어떤 맛이었어?", "다음엔 내가 해 줄게."])
reactions = Array[String](["…쌉싸름한데, 마지막엔 고소했어요. 할머니 같았어요.", "…! 정말요? …도토리, 많이 모아 올게요."])

[sub_resource type="Resource" id="EveningTalk_2"]
script = ExtResource("10_talk")
line = "…뒷산 도토리나무, 올해 많이 열렸어요."
replies = Array[String](["같이 주우러 갈까?", "다람쥐 덕분에 겨울 걱정 없겠다."])
reactions = Array[String](["…다, 다음에요. 제일 좋은 나무는 비밀이에요.", "…헤헤. 겨울엔 묵 많이 해 주세요."])

[sub_resource type="Resource" id="EveningTalk_3"]
script = ExtResource("10_talk")
line = "…사람은 조금 무서웠는데, 당신은 괜찮아요."
replies = Array[String](["고마워. 천천히 친해지자.", "할머니한테도 그랬어?"])
reactions = Array[String](["…네. 천천히요.", "…네. 할머니가 처음이었고, 당신이 두 번째예요."])

[sub_resource type="Resource" id="TierTalk_1"]
script = ExtResource("10_talk")
line = "…저, 겨울마다 도토리 묻은 데를 까먹어요."
replies = Array[String](["같이 찾아 줄까?", "그럼 겨울엔 어떡해?"])
reactions = Array[String](["…네. …할머니도 그렇게 말해 줬어요.", "…할머니가 묵 쒀서 나눠 줬어요. 까먹은 도토리까지 다 찾아서요."])

[sub_resource type="Resource" id="Reward_1"]
script = ExtResource("30_reward")
talk = SubResource("TierTalk_1")
gift_line = "…제일 반질반질한 도토리예요."
gift_ingredient = ExtResource("31_gift")
gift_amount = 3

[sub_resource type="Resource" id="TierTalk_2"]
script = ExtResource("10_talk")
line = "…할머니 마지막 겨울에, 제가 도토리를 제일 많이 가져다 드렸어요. 묵 많이 쑤시라고."
replies = Array[String](["할머니가 기뻐하셨겠다", "고마워, 할머니 대신"])
reactions = Array[String](["…웃으셨어요. 근데 묵은 다 저한테 다시 주셨어요.", "…! …천만에요. …{name}도 많이 먹어요."])

[sub_resource type="Resource" id="Reward_2"]
script = ExtResource("30_reward")
talk = SubResource("TierTalk_2")
gift_line = "…겨울 몫까지 가져왔어요."
gift_ingredient = ExtResource("31_gift")
gift_amount = 5

[sub_resource type="Resource" id="TierTalk_3"]
script = ExtResource("10_talk")
line = "…이제 숨겨 둔 데 알려 줄게요. 제일 좋은 도토리나무."
replies = Array[String](["비밀 아니었어?", "고마워, 꼭 지킬게"])
reactions = Array[String](["…식구한테는 비밀 아니에요.", "…네. 우리 둘만 알아요."])

[sub_resource type="Resource" id="Reward_3"]
script = ExtResource("30_reward")
talk = SubResource("TierTalk_3")
gift_line = "…할머니가 깎아 준 팽이예요. …같이 돌려요."
keepsake = ExtResource("32_keepsake")

[sub_resource type="Resource" id="StoryTalk_1"]
script = ExtResource("10_talk")
line = "…없어요. 아무리 파도 없어요."
expression = &"sad"
replies = Array[String](["뭐가 없어?", "천천히 말해 봐"])
reactions = Array[String](["…할머니 마지막 겨울에 묻어 둔 도토리요. 할머니 드리려고 따로 묻은 거.", "…할머니 드리려고 묻어 둔 도토리요. 마지막 겨울에요."])
reaction_expressions = Array[StringName]([&"sad", &"sad"])

[sub_resource type="Resource" id="StoryTalk_2"]
script = ExtResource("10_talk")
line = "…어디 묻었는지 기억이 안 나요. 저는 늘 까먹어요. 할머니가 같이 찾아 주셨는데."
expression = &"sad"
replies = Array[String](["이번엔 내가 같이 찾을게", "어느 나무 근처였어?"])
reactions = Array[String](["…정말요? …그럼 내일부터 뒷산 갈 때마다 기억해 볼게요.", "…큰 나무요. 평상에서 보이는. …그것만 생각나요."])
reaction_expressions = Array[StringName]([&"surprised", &""])

[sub_resource type="Resource" id="StoryChapter_1"]
script = ExtResource("40_chapter")
id = &"squirrel_spring_1"
open_day = 4
talks = Array[ExtResource("10_talk")]([SubResource("StoryTalk_1"), SubResource("StoryTalk_2")])

[sub_resource type="Resource" id="StoryTalk_3"]
script = ExtResource("10_talk")
line = "…찾았어요. 평상에서 보이는 그 나무 아래요."
expression = &"surprised"
replies = Array[String](["다행이다!", "도토리는 무사했어?"])
reactions = Array[String](["…근데 도토리가 없었어요.", "…아뇨. 도토리가 없었어요."])
reaction_expressions = Array[StringName]([&"sad", &"sad"])

[sub_resource type="Resource" id="StoryTalk_4"]
script = ExtResource("10_talk")
line = "…대신 싹이 나 있었어요. 손가락만 한 거. 잎이 두 장."
replies = Array[String](["도토리가 싹을 틔웠구나", "할머니 몫 도토리가?"])
reactions = Array[String](["…네. 겨울 동안 혼자 기다렸나 봐요. …봄 오기를.", "…네. 할머니 못 드린 건데. …나무가 되려나 봐요."])
reaction_expressions = Array[StringName]([&"happy", &"sad"])

[sub_resource type="Resource" id="StoryChapter_2"]
script = ExtResource("40_chapter")
id = &"squirrel_spring_2"
open_day = 8
talks = Array[ExtResource("10_talk")]([SubResource("StoryTalk_3"), SubResource("StoryTalk_4")])

[sub_resource type="Resource" id="StoryTalk_5"]
script = ExtResource("10_talk")
line = "…그 싹, 저기 두면 큰 나무 그늘에 가려서 잘 못 자란대요."
expression = &"sad"
replies = Array[String](["그럼 옮겨 심자", "어디가 좋을까?"])
reactions = Array[String](["…평상 옆이요. 해 잘 드는 데. …제가 정해 놨어요.", "…평상 옆이요. 해 잘 들고, 할머니 자리 옆이에요."])
reaction_expressions = Array[StringName]([&"happy", &"happy"])

[sub_resource type="Resource" id="StoryTalk_6"]
script = ExtResource("10_talk")
line = "(흙 묻은 앞발로 싹을 꾹꾹 눌러 준다) …다 됐어요. 할머니 나무예요."
expression = &"happy"
replies = Array[String](["이름표도 달아 주자", "다람쥐 나무이기도 해"])
reactions = Array[String](["…네. …크면 도토리 열리겠죠? 그럼 그건 {name} 몫이에요.", "…! …그럼 우리 둘 나무예요. …아니, 할머니까지 셋."])
reaction_expressions = Array[StringName]([&"happy", &"surprised"])

[sub_resource type="Resource" id="StoryChapter_3"]
script = ExtResource("40_chapter")
id = &"squirrel_spring_3"
open_day = 12
talks = Array[ExtResource("10_talk")]([SubResource("StoryTalk_5"), SubResource("StoryTalk_6")])

[resource]
script = ExtResource("1_guest")
id = &"squirrel"
display_name = "다람쥐"
personality = "겁이 많아 말이 짧지만, 도토리 얘기만 나오면 눈이 반짝인다. 뒷산 도토리나무 자리를 마을에서 제일 잘 안다."
favorite_recipes = Array[ExtResource("2_recipe")]([ExtResource("4_acorn_jelly"), ExtResource("5_kimbop"), ExtResource("7_mukbap"), ExtResource("8_gangjeong")])
disliked_recipes = Array[ExtResource("2_recipe")]([ExtResource("9_disliked")])
payment_ingredients = Array[ExtResource("3_ingredient")]([ExtResource("6_acorn"), ExtResource("6_acorn")])
order_line = "…{recipe}. 주, 주세요."
rain_order_line = "…비, 싫어요. 꼬리 다 젖었어요. …따뜻한 {recipe}, 주세요."
curious_order_line = "…저거, 냄새 좋아요. …{recipe}, 먹어 봐도 돼요?"
request_missed_line = "…조금 달라요. …그래도, 맛있어요."
grandma_taste_line = "…! 할머니 맛…이에요."
fallback_order_line = "…{recipe}. 그, 그거라도요."
first_order_line = "…할머니 밥집 냄새가 나서… 와 봤어요. 할머니 손주…예요? …반가워요. {recipe}, 주, 주세요."
taste_hint_line = "…깨, 톡톡 뿌려 주면… 좋아요."
porch_greeting_line = "…저, 여기 앉아도 돼요? …할머니 옆자리, 제 자리였어요."
thanks_line = "…맛있어요. 도토리, 두고 갈게요."
perfect_line = "…! 진짜 맛있어요! 제일 동글동글한 도토리로 더 드릴게요."
evening_talks = Array[ExtResource("10_talk")]([SubResource("EveningTalk_1"), SubResource("EveningTalk_2"), SubResource("EveningTalk_3")])
story_chapters = Array[ExtResource("40_chapter")]([SubResource("StoryChapter_1"), SubResource("StoryChapter_2"), SubResource("StoryChapter_3")])
note_recipes = Array[ExtResource("2_recipe")]([ExtResource("4_acorn_jelly"), ExtResource("7_mukbap")])
feast_line = "…오늘은, 하나도 안 무서워요. 도토리 많이 가져왔어요."
story_feast_line = "…오다가 할머니 나무 보고 왔어요. 잎이 세 장 됐어요. …잔치 구경하라고, 물도 줬어요."
note_line = "…이거, 할머니가 주신 거예요. 「{recipe}」… 돌려드릴게요."
favorite_garnish = ExtResource("20_garnish")
taste_miss_line = "…맛있어요. …톡톡 씹히는 게 있으면 더 좋을 것 같아요."
taste_match_line = "…! 깨가 톡톡. …제일 좋아하는 맛이에요."
regular_rewards = Array[ExtResource("30_reward")]([SubResource("Reward_1"), SubResource("Reward_2"), SubResource("Reward_3")])
