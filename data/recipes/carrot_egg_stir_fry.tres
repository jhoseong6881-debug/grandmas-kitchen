[resource]
script = ExtResource("1_recipe")
id = &"carrot_egg_stir_fry"
display_name = "당근 계란 볶음"
ingredients = Array[ExtResource("2_ingredient")]([ExtResource("3_carrot"), ExtResource("4_egg")])
