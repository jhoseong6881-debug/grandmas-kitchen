secret_reveal_line = "볶을 땐 말이야, 계란은 팬 가장자리로 받아서 살살 익혀야 보들보들해. 네 할머니 말버릇이었지!"
grandma_taste_line = "꼬꼬! 바로 이 맛이야! 네 할머니가 부엌에 서 있는 줄 알았다니까!"
note_puzzle = SubResource("NotePuzzle_1")
