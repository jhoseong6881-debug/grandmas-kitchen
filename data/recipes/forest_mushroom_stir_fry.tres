secret_hint = "버섯은 금색에 막 들어올 때 받기"
secret_teller_id = &"hedgehog"
secret_reveal_line = "…버섯은 오래 띄우면 물러진다. 네 할머니는 금색에 들어오자마자 받았다."
grandma_taste_line = "…흠. 쫄깃하군. …그 사람 맛이다."
note_puzzle = SubResource("NotePuzzle_1")
