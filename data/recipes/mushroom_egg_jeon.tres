[sub_resource type="Resource" id="CookStep_1"]
script = ExtResource("14_cook_step")
type = 8
ingredient = ExtResource("3_mushroom")
count = 4

[sub_resource type="Resource" id="CookStep_2"]
script = ExtResource("14_cook_step")
type = 3
subject_name = "버섯전"
count = 1
speed = 1.1
secret_end = 0.45

[sub_resource type="Resource" id="NoteLine_1"]
script = ExtResource("nl_script")
text = "버섯은 도톰하게 썬다"

[sub_resource type="Resource" id="NoteLine_2"]
script = ExtResource("nl_script")
kind = 2
prompt = "버섯에 무슨 옷부터 입히셨을까? 차례로 골라요"
text = "버섯에 차례로 옷을 입힌다\n   {blank}"
wrong_line = "음… 계란이 주르륵 흘러내리겠는데."
order_answer = Array[ExtResource("2_ingredient")]([ExtResource("3_mushroom"), ExtResource("np_flour"), ExtResource("4_egg")])
readable_count = 1
extra_cards = Array[ExtResource("2_ingredient")]([ExtResource("np_water")])
extra_card_line = "물은… 안 묻히셨던 것 같은데."
container_name = "그릇"

[sub_resource type="Resource" id="NoteLine_3"]
script = ExtResource("nl_script")
text = "기름 두른 팬에 노릇하게 부친다"

[sub_resource type="Resource" id="NotePuzzle_1"]
script = ExtResource("np_script")
lines = Array[ExtResource("nl_script")]([SubResource("NoteLine_1"), SubResource("NoteLine_2"), SubResource("NoteLine_3")])
hint = "가루옷을 입혀야 계란이 착 붙어."

[resource]
script = ExtResource("1_recipe")
id = &"mushroom_egg_jeon"
display_name = "버섯 계란전"
ingredients = Array[ExtResource("2_ingredient")]([ExtResource("3_mushroom"), ExtResource("4_egg")])
cook_steps = Array[ExtResource("14_cook_step")]([SubResource("CookStep_1"), SubResource("CookStep_2")])
minigame_ingredient_name = "버섯"
secret_hint = "버섯전은 막 금색이 됐을 때 바로"
secret_teller_id = &"hedgehog"
secret_reveal_line = "…버섯전은 막 금색이 되자마자 뒤집어야 촉촉하다. 네 할머니가 그랬다."
grandma_taste_line = "…촉촉하군. …고맙다, {name}."
note_puzzle = SubResource("NotePuzzle_1")
