[sub_resource type="Resource" id="CookStep_1"]
script = ExtResource("15_cook_step")
ingredient = ExtResource("3_carrot")
action_name = "깍둑썰기"
count = 6

[sub_resource type="Resource" id="CookStep_2"]
script = ExtResource("15_cook_step")
type = 7
ingredient = ExtResource("3_carrot")
count = 10
speed = 0.85
secret_start = 0.3
secret_end = 0.7

[sub_resource type="Resource" id="NoteLine_1"]
script = ExtResource("nl_script")
text = "당근은 큼직하게 깍둑 썬다"

[sub_resource type="Resource" id="NoteLine_2"]
script = ExtResource("nl_script")
kind = 2
text = "냄비에 차례로 넣고 조린다\n   {blank}"
wrong_line = "음… 꿀을 일찍 넣으면 쓴맛이 날 텐데."
order_answer = Array[ExtResource("2_ingredient")]([ExtResource("3_carrot"), ExtResource("np_water"), ExtResource("4_honey")])
readable_count = 1
extra_cards = Array[ExtResource("2_ingredient")]([ExtResource("np_egg")])
extra_card_line = "계란은… 조림엔 안 넣으셨는데."
container_name = "냄비"

[sub_resource type="Resource" id="NoteLine_3"]
script = ExtResource("nl_script")
text = "국물이 자작해지면 불을 끈다"

[sub_resource type="Resource" id="NotePuzzle_1"]
script = ExtResource("np_script")
lines = Array[ExtResource("nl_script")]([SubResource("NoteLine_1"), SubResource("NoteLine_2"), SubResource("NoteLine_3")])
hint = "꿀은 오래 끓이면 쓴맛이 나. 불 끄기 전에 쪼르륵."

[resource]
script = ExtResource("1_recipe")
id = &"honey_carrot_jorim"
display_name = "꿀 당근 조림"
ingredients = Array[ExtResource("2_ingredient")]([ExtResource("3_carrot"), ExtResource("4_honey")])
cook_steps = Array[ExtResource("15_cook_step")]([SubResource("CookStep_1"), SubResource("CookStep_2")])
secret_hint = "조림은 박자에 딱 맞춰 젓기"
secret_teller_id = &"bear"
secret_reveal_line = "할머니는 조림 저을 때 노래를 흥얼거리셨어. 박자에 딱딱 맞춰서. 그래야 윤기가 고르게 돈대."
grandma_taste_line = "음~ 이 윤기… 할머니 노랫소리가 들리는 것 같아."
simmer_sauce = ExtResource("5_honey_coating")
note_puzzle = SubResource("NotePuzzle_1")
