[resource]
script = ExtResource("1_rain")
rain_days = Array[int]([3])
random_from_day = 4
rain_chance = 0.2
dry_days = Array[int]([15])
morning_text = "밤새 봄비가 내렸어요. 오늘은 하루 종일 보슬보슬 비가 와요."
sunset_text = "비가 그치고, 해가 뉘엿뉘엿 지고 있어요…"
warm_recipes = Array[ExtResource("2_recipe")]([ExtResource("3_carrot_acorn_jeon"), ExtResource("4_mushroom_egg_jeon"), ExtResource("5_honey_carrot_jorim"), ExtResource("6_carrot_egg_stir_fry"), ExtResource("7_forest_mushroom_stir_fry"), ExtResource("8_acorn_jelly_mushroom_bap")])
warm_order_chance = 0.7
rain_sound = &"rain"
rain_music = ExtResource("9_music")
